    src/ui/embedded_stub.c

# mimalloc (vendored; global allocator override on MinGW only)
#
# Routing is platform-specific:
#  * Unix (macOS/Linux): ordinary CBM C allocation remains on libc. Defining
#    MI_MALLOC_OVERRIDE would make this binary's free == mi_free while system
#    libraries keep allocating through the platform allocator; pointers crossing
#    that boundary caused "mi_free: invalid pointer" aborts on macOS. Rust plus
#    the explicitly bound tree-sitter/SQLite paths still use this mimalloc object.
#  * Windows (MinGW, static CRT): define MI_MALLOC_OVERRIDE=1 to compile the
#    static-CRT override added in mimalloc 3.3.0 (the _MSC_VER / _ACRTIMP /
#    _CRT_HYBRIDPATCHABLE entry points) which take precedence over the static
#    CRT's malloc/free.
# Note: mimalloc's source gates the override body on MI_MALLOC_OVERRIDE (CMake
# derives it from the MI_OVERRIDE option); MI_OVERRIDE alone is not read by the
# source — it is kept here only as this project's prod/test marker.
MIMALLOC_SRC = vendored/mimalloc/src/static.c
MIMALLOC_OVERRIDE_DEFINE :=
ifeq ($(IS_MINGW),yes)
MIMALLOC_OVERRIDE_DEFINE := -DMI_MALLOC_OVERRIDE=1
endif
MIMALLOC_CFLAGS = -std=c11 -O2 -w \
                  -Ivendored/mimalloc/include \
                  -Ivendored/mimalloc/src \
                  -DMI_OVERRIDE=1 \
                  $(MIMALLOC_OVERRIDE_DEFINE)
MIMALLOC_CFLAGS_TEST = -std=c11 -g -O1 -w \
                       -Ivendored/mimalloc/include \
                       -Ivendored/mimalloc/src \
                       -DMI_OVERRIDE=0

# sqlite3 (vendored amalgamation — compiled ourselves for ASan instrumentation)
# SQLITE_ENABLE_FTS5: enables the FTS5 full-text search extension used by the
# BM25 search path in search_graph (see nodes_fts virtual table in store.c).
SQLITE3_SRC = vendored/sqlite3/sqlite3.c
SQLITE3_CFLAGS = -std=c11 -O2 -w -DSQLITE_DQS=0 -DSQLITE_THREADSAFE=1 -DSQLITE_ENABLE_FTS5
SQLITE3_CFLAGS_TEST = -std=c11 -g -O1 -w -DSQLITE_DQS=0 -DSQLITE_THREADSAFE=1 -DSQLITE_ENABLE_FTS5

# TRE regex (vendored, Windows only — POSIX uses system <regex.h>)
TRE_SRC = vendored/tre/tre_all.c
TRE_CFLAGS = -std=c11 -g -O1 -w -Ivendored/tre

# yyjson (vendored)
YYJSON_SRC = vendored/yyjson/yyjson.c

# All production sources
PROD_SRCS = $(FOUNDATION_SRCS) $(STORE_SRCS) $(CYPHER_SRCS) $(MCP_SRCS) $(DISCOVER_SRCS) $(GRAPH_BUFFER_SRCS) $(PIPELINE_SRCS) $(SIMHASH_SRCS) $(SEMANTIC_SRCS) $(TRACES_SRCS) $(WATCHER_SRCS) $(GIT_SRCS) $(CLI_SRCS) $(UI_SRCS) $(YYJSON_SRC)
EXISTING_C_SRCS = $(EXTRACTION_SRCS) $(LSP_SRCS) $(TS_RUNTIME_SRC) \
                  $(GRAMMAR_SRCS) $(AC_LZ4_SRCS) $(ZSTD_SRCS) $(SQLITE_WRITER_SRC)

# ── #229: production-binary -Werror overlays (native MinGW GCC 14.1) ──────────
# The `cbm` and `cbm-with-ui` production binaries compile the vendored sources
# directly (unlike libcbm, whose overlays live under $(LIBCBM_DIR)). Three
# vendored sources trip GCC 14 -Werror diagnostics on the native Windows toolchain
# — and src/ui/layout3d.c carries a genuine unchecked allocation-size bug.
# apply_ui_werror_patch.py emits hash-checked, build-local overlays with
# root-cause fixes (NOT warning suppression); PROD_SRCS_UI substitutes those
# overlays for the vendored paths so they are compiled into the production
# binaries in place of the vendored objects. Nothing under vendor/ is written.
# Deferred (=) so $(BUILD_DIR) resolves to its final value at use time.
ASTRO_UI_WERROR_OVERLAY_DIR = $(BUILD_DIR)/astrolabe-ui-werror
ASTRO_UI_WERROR_SRCS = src/pipeline/pass_envscan.c src/watcher/watcher.c src/ui/layout3d.c
ASTRO_UI_WERROR_OVERLAYS = $(patsubst %.c,$(ASTRO_UI_WERROR_OVERLAY_DIR)/%.c,$(ASTRO_UI_WERROR_SRCS))
# Text swap of each vendored path for its overlay path. The embedded_stub ->
# embedded_assets swap for the UI build (below) composes on top; the files are
# disjoint so the substitutions never interfere.
PROD_SRCS_UI = $(subst src/ui/layout3d.c,$(ASTRO_UI_WERROR_OVERLAY_DIR)/src/ui/layout3d.c,\
               $(subst src/watcher/watcher.c,$(ASTRO_UI_WERROR_OVERLAY_DIR)/src/watcher/watcher.c,\
               $(subst src/pipeline/pass_envscan.c,$(ASTRO_UI_WERROR_OVERLAY_DIR)/src/pipeline/pass_envscan.c,\
               $(PROD_SRCS_DIAG))))

# ── #282: worker-failure diagnostics reach the production binaries too ────────
# The parity gates compare astrolabe (libcbm, overlaid) against the production
# binary LIVE, so both sides must carry identical behavior: early repo_path
# validation before supervision, and the evidence-carrying failure response.
# Aggregate attempt 11 proved the divergence — the shared
# tool/index_repository/empty case produced the enriched payload on the
# astrolabe side only. Non-chained apply from the pinned vendored sources (the
# env-store overlay is astrolabe-specific and must NOT reach the production
# binary).
ASTRO_WORKER_DIAG_PROD_DIR = $(BUILD_DIR)/astrolabe-worker-diag
ASTRO_WORKER_DIAG_SRCS = src/mcp/mcp.c src/mcp/index_supervisor.c
ASTRO_WORKER_DIAG_PROD_OVERLAYS = $(patsubst %.c,$(ASTRO_WORKER_DIAG_PROD_DIR)/%.c,$(ASTRO_WORKER_DIAG_SRCS))
PROD_SRCS_DIAG = $(subst src/mcp/mcp.c,$(ASTRO_WORKER_DIAG_PROD_DIR)/src/mcp/mcp.c,\
                 $(subst src/mcp/index_supervisor.c,$(ASTRO_WORKER_DIAG_PROD_DIR)/src/mcp/index_supervisor.c,\
                 $(PROD_SRCS)))
# (The overlay-generation rule lives below ASTROLABE_PATCH_DIR's definition:
# make expands PREREQUISITE lists at read time, so a rule here would see an
# empty patch-dir path.)

