# Makefile.cbm — Build system for pure C rewrite
#
# Usage:
#   make -f Makefile.cbm libcbm         # Static library for Astrolabe FFI
#   make -f Makefile.cbm cbm            # Production binary
#   make -f Makefile.cbm clean-c        # Remove build artifacts
#
# The C test suite was deleted under the manual-FSV-only doctrine (#397);
# this Makefile builds only production artifacts (libcbm.a, cbm, cbm-with-ui).

# Captured BEFORE any -include adds generated .d files to MAKEFILE_LIST:
# $(lastword MAKEFILE_LIST) after the #280 per-TU `-include build/.../*.d`
# lines silently re-points to the last dep file's directory (bit the release
# gate: lint-cppcheck-astrolabe scanned build/c/tuprod/... instead of this
# directory once a prod build had populated dep files).
ASTROLABE_PATCH_DIR := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))

# A failed linker/localizer command must not leave a changed target looking
# current to a later make invocation.  GNU make deletes such targets before it
# returns the failure to cbm-sys.
.DELETE_ON_ERROR:

# Compiler selection — override via: make CC=gcc CXX=g++
# macOS: cc (Apple Clang) — universal binary with ASan support
# Linux: gcc/g++ — system default with full sanitizer support
# CI scripts pass CC/CXX explicitly; don't rely on defaults here

# Target architecture (macOS): build.sh/test.sh export ARCHFLAGS="-arch <arch>"
# (see scripts/env.sh). Fold it into the compiler drivers with `override` so it
# reaches EVERY compile and link recipe — including the vendored objects below
# that use their own *_CFLAGS — and so it survives a command-line `CC=` override.
# ARCHFLAGS is empty on Linux/Windows and for native direct `make` invocations,
# leaving CC/CXX unchanged there.
override CC := $(CC) $(ARCHFLAGS)
override CXX := $(CXX) $(ARCHFLAGS)

# ── Common flags ─────────────────────────────────────────────────

# Include paths for:
#   src/         — new foundation headers
#   vendored/    — yyjson, xxhash, sqlite3
#   internal/cbm — existing extraction headers (cbm.h, helpers.h, etc.)
#   internal/cbm/vendored/ts_runtime/include — tree-sitter API
CBM_DIR = internal/cbm
TS_INCLUDE = $(CBM_DIR)/vendored/ts_runtime/include
# Vendored tree-sitter src/ contains unicode/ headers (umachine.h, utf.h, utf8.h).
# This ensures we use our vendored copies instead of requiring system libicu-dev.
TS_SRC = $(CBM_DIR)/vendored/ts_runtime/src

# GNU Make expands $(shell ...) through a POSIX shell. Keep recipe commands in
# their native form, but normalize Windows separators for compiler probes.
CC_FOR_SHELL := $(subst \,/,$(CC))

# GCC-only warning suppressions (Clang rejects unknown -Wno-* with -Werror).
#
# #274: deterministic, fail-closed compiler-family detection. The former probe
#   IS_GCC := $(shell ... grep __GNUC__ && ! ... grep __clang__ && echo yes || echo no)
# ran the compiler TWICE and folded EVERY failure — including a compiler that
# could not be invoked at all (PATH miss, Windows path mangling, transient spawn
# failure) — into a plain "no" via the trailing `|| echo no`. "no" then silently
# drops the -Wno-stringop-truncation / -Wno-alloc-size-larger-than suppressions,
# so an invocation that merely failed to run the probe compiles the SAME sources
# under a DIFFERENT -Werror contract than one that ran it: a per-invocation flip
# of the build contract (observed as cbm vs cbm-with-ui diverging under #229).
#
# Deterministic replacement: run the compiler ONCE, capture its predefined-macro
# dump, and classify into exactly one family. Clang => IS_GCC=no is a real answer
# (Clang genuinely rejects unknown -Wno-*). A probe that cannot run the compiler
# ("probe-failed"), or a compiler that is neither GCC nor Clang ("other"), is a
# HARD ERROR with remediation — never a silent suppression flip. Given the same
# environment the macro dump is identical, so CC_FAMILY (and thus IS_GCC) is a
# pure function of CC: the same across the cbm, cbm-with-ui, and libcbm goals,
# which all read this single parse-time assignment.
CC_FAMILY := $(shell dump="$$(echo | $(CC_FOR_SHELL) -dM -E - 2>/dev/null)"; \
	if [ -z "$$dump" ]; then echo probe-failed; \
	elif printf '%s\n' "$$dump" | grep -q '__clang__'; then echo clang; \
	elif printf '%s\n' "$$dump" | grep -q '__GNUC__'; then echo gcc; \
	else echo other; fi)
ifeq ($(filter gcc clang,$(CC_FAMILY)),)
$(error [#274] Makefile.cbm could not classify the compiler family for CC="$(CC)" (probe result: '$(CC_FAMILY)'). `echo | $(CC_FOR_SHELL) -dM -E -` must define __GNUC__ (GCC) or __clang__ (Clang) so the GCC-only -Wno-* suppression set is chosen deterministically. remediation: pass a working CC=/path/to/gcc (or clang) on the make command line, or bootstrap the pinned toolchain via `powershell -ExecutionPolicy Bypass -File scripts/windows-gnu-toolchain.ps1 -Issue <driving-issue> -Bootstrap`. Refusing to guess a warning-suppression state.)
endif
IS_GCC := $(if $(filter gcc,$(CC_FAMILY)),yes,no)
# #273: the two blanket suppressions -Wno-stringop-truncation and
# -Wno-alloc-size-larger-than were REMOVED. They masked genuine latent C defects
# in the owned CBM sources (unchecked alloc-size in ui/layout3d.c compute_call_depth
# and pipeline/pass_definitions.c; non-NUL-terminating strncpy in watcher/watcher.c
# and the former pipeline/pass_envscan.c). The live sites are root-cause-fixed unconditionally
# (strnlen+memcpy+explicit NUL; fail-closed range guards), so the diagnostics stay
# ON as -Werror across every artifact — libcbm.a, the production binaries, and the
# test-runner — and any future truncation / oversized-allocation defect fails the
# build instead of shipping silently. -Wno-format-truncation and -Wno-unused-result
# remain: they suppress a different, out-of-scope diagnostic class (see #274 follow-up).
GCC_ONLY_FLAGS :=
ifeq ($(IS_GCC),yes)
GCC_ONLY_FLAGS := -Wno-format-truncation -Wno-unused-result
endif

CFLAGS_COMMON = -std=c11 -D_DEFAULT_SOURCE -D_GNU_SOURCE -Wall -Wextra -Werror \
                -Wno-unused-parameter -Wno-sign-compare \
                $(GCC_ONLY_FLAGS) \
                -Isrc -Ivendored -Ivendored/sqlite3 \
                -Ivendored/mimalloc/include \
                -I$(CBM_DIR) -I$(TS_INCLUDE)

CXXFLAGS_COMMON = -std=c++14 -Wall -Wextra -Werror \
                  -Wno-unused-parameter \
                  -I$(CBM_DIR) -I$(TS_INCLUDE)

# Production flags (CFLAGS_EXTRA allows CI to inject -DCBM_VERSION)
# CBM_BIND_TS_ALLOCATOR=1: bind the tree-sitter runtime to mimalloc (#424). Only
# the prod build uses mimalloc (MI_OVERRIDE=1); the test build is CRT+ASan, where
# binding would create an alloc/free mismatch, so the guard is prod-only.
CFLAGS_PROD = $(CFLAGS_COMMON) -O2 -DCBM_BIND_TS_ALLOCATOR=1 $(CFLAGS_EXTRA)
CXXFLAGS_PROD = $(CXXFLAGS_COMMON) -O2 $(CXXFLAGS_EXTRA)

# Windows needs ws2_32 (Winsock), psapi (GetProcessMemoryInfo), shell32
# (CommandLineToArgvW — the UTF-8 argv path in main.c, #423/#20), and
# --allow-multiple-definition (MinGW CRT symbol clashes). The relocatable
# libcbm merge needs the same allowance before the archive is formed.
# Auto-detected via compiler; no manual override needed.
#
# #387: derive IS_MINGW fail-closed from the compiler macro dump rather than the
# former `... grep _WIN32 ... || echo no` form, whose trailing `|| echo no` folded
# a probe FAILURE into a silent non-Windows "no" that drops -lws2_32/-lpsapi/
# -lshell32. CC_FAMILY above already refused an unprobeable compiler ($(error) on
# probe-failed), so a dump that runs but lacks _WIN32 is a real non-Windows answer.
CC_MACRO_DUMP := $(shell echo | $(CC_FOR_SHELL) -dM -E - 2>/dev/null)
IS_MINGW := $(if $(findstring define _WIN32 ,$(CC_MACRO_DUMP)),yes,no)
WIN32_LIBS :=
MINGW_RELOC_LD_FLAGS :=
ifeq ($(IS_MINGW),yes)
WIN32_LIBS := -lws2_32 -lpsapi -lshell32 -Wl,--allow-multiple-definition -Wl,--stack,8388608 -static
MINGW_RELOC_LD_FLAGS := --allow-multiple-definition --no-insert-timestamp
endif

# STATIC=1 produces a fully static binary (for Alpine/musl portable builds)
ifeq ($(STATIC),1)
STATIC_FLAGS := -static
endif

LDFLAGS = -lm -lstdc++ -lpthread -lz $(WIN32_LIBS) $(STATIC_FLAGS)

# ── Source files ─────────────────────────────────────────────────

FOUNDATION_SRCS = \
    src/foundation/arena.c \
    src/foundation/hash_table.c \
    src/foundation/str_intern.c \
    src/foundation/log.c \
    src/foundation/str_util.c \
    src/foundation/platform.c \
    src/foundation/system_info.c \
    src/foundation/slab_alloc.c \
    src/foundation/yaml.c \
    src/foundation/compat.c \
    src/foundation/compat_thread.c \
    src/foundation/compat_fs.c \
    src/foundation/compat_regex.c \
    src/foundation/mem.c \
    src/foundation/diagnostics.c \
    src/foundation/profile.c \
    src/foundation/dump_verify.c \
    src/foundation/limits.c \
    src/foundation/subprocess.c \
    src/foundation/worker_progress.c \
    src/foundation/sha256.c

# Existing extraction C code (compiled from current location)
EXTRACTION_SRCS = \
    $(CBM_DIR)/cbm.c \
    $(CBM_DIR)/extract_defs.c \
    $(CBM_DIR)/extract_calls.c \
    $(CBM_DIR)/extract_imports.c \
    $(CBM_DIR)/extract_usages.c \
    $(CBM_DIR)/extract_unified.c \
    $(CBM_DIR)/extract_semantic.c \
    $(CBM_DIR)/extract_type_refs.c \
    $(CBM_DIR)/extract_type_assigns.c \
    $(CBM_DIR)/extract_env_accesses.c \
    $(CBM_DIR)/extract_channels.c \
    $(CBM_DIR)/extract_powershell.c \
    $(CBM_DIR)/extract_k8s.c \
    $(CBM_DIR)/helpers.c \
    $(CBM_DIR)/lang_specs.c \
    $(CBM_DIR)/service_patterns.c

# LSP resolvers (compiled as one unit via lsp_all.c)
LSP_SRCS = $(CBM_DIR)/lsp_all.c

# Header/source dependencies of the lsp_all unity object. lsp_all.c #includes
# every lsp/*.c resolver, which in turn include cbm.h — and CBMCall is copied
# BY VALUE across the lsp -> pipeline boundary (cbm_calls_push). This object is
# compiled standalone and linked in, NOT recompiled with the rest on every link,
# so it must list the headers/sources it pulls in. Without this, a changed struct
# layout (e.g. a new CBMCall field) leaves a stale lsp_all.o with the old layout —
# an ODR mismatch that under-reads the by-value struct copy. Explicit because this
# Makefile does not use compiler auto-dependency (-MMD) generation.
LSP_UNITY_DEPS = $(CBM_DIR)/lsp_all.c \
                 $(wildcard $(CBM_DIR)/lsp/*.c $(CBM_DIR)/lsp/*.h \
                            $(CBM_DIR)/lsp/generated/*.c $(CBM_DIR)/*.h)

# Tree-sitter runtime
TS_RUNTIME_SRC = $(CBM_DIR)/ts_runtime.c

# ── Grammar set selection (#283) ─────────────────────────────────
# CBM_GRAMMAR_SET is a declared build knob choosing which tree-sitter grammars
# are compiled into the archive/binary. Default = full: every grammar_*.c shim
# (157 today), byte-identical to prior behavior — nothing changes silently.
#
# `core` compiles only the declared core-language set below and links a
# grammar-subset build: every non-core grammar_<lang>.c parser.c drops out of
# GRAMMAR_SRCS (the ~1.19 GiB of static parse tables is the dominant release
# binary-size payload, #63), and grammar_stubs.c supplies each dropped
# tree_sitter_<lang>() symbol as a NULL-returning stub so the link stays intact.
# Indexing a stubbed language then fails closed with a labeled
# CBM_GRAMMAR_STUBBED error (see cbm.c) — never a silent parse miss.
CBM_GRAMMAR_SET ?= full

# Declared core-language registry (a knob, not a constant buried in a rule).
# Each token is a grammar_<token>.c shim whose parser.c defines exactly
# tree_sitter_<token>. Edit THIS list to change the core set. Keep it in sync
# with grammar_stubs.c: a core token here MUST have a `#ifndef CBM_CORE_<token>`
# stub guard there (the core build fails closed on any unresolved symbol).
CBM_GRAMMAR_CORE_LANGS = go python javascript typescript tsx rust java c cpp \
    c_sharp ruby bash powershell json yaml html css markdown toml sql

# grammar_stubs.c is never part of the full-set wildcard: in a full build every
# real parser.c supplies these symbols and the stub file must not be compiled
# (it would redefine them). It is added explicitly only in the core build.
GRAMMAR_STUBS_SRC = $(CBM_DIR)/grammar_stubs.c

ifeq ($(CBM_GRAMMAR_SET),full)
  # All 157 grammar shim files (grammar_stubs.c excluded — full build defines
  # every real factory).
  GRAMMAR_SRCS = $(filter-out $(GRAMMAR_STUBS_SRC),$(wildcard $(CBM_DIR)/grammar_*.c))
  GRAMMAR_SUBSET_DEFS =
else ifeq ($(CBM_GRAMMAR_SET),core)
  GRAMMAR_CORE_SRCS = $(addsuffix .c,$(addprefix $(CBM_DIR)/grammar_,$(CBM_GRAMMAR_CORE_LANGS)))
  GRAMMAR_SRCS = $(GRAMMAR_CORE_SRCS) $(GRAMMAR_STUBS_SRC)
  GRAMMAR_SUBSET_DEFS = -DCBM_GRAMMAR_SET_CORE \
                        $(addprefix -DCBM_CORE_,$(CBM_GRAMMAR_CORE_LANGS))
else
  $(error CBM_GRAMMAR_SET must be 'full' or 'core', got '$(CBM_GRAMMAR_SET)')
endif

# LZ4 + Aho-Corasick
AC_LZ4_SRCS = $(CBM_DIR)/ac.c $(CBM_DIR)/lz4_store.c

# Zstd compression (for persistent artifacts)
ZSTD_SRCS = $(CBM_DIR)/zstd_store.c

# SQLite writer
SQLITE_WRITER_SRC = $(CBM_DIR)/sqlite_writer.c

# Store module (new)
STORE_SRCS = src/store/store.c

# Cypher module (new)
CYPHER_SRCS = src/cypher/cypher.c

# MCP server module (new)
MCP_SRCS = src/mcp/mcp.c src/mcp/index_supervisor.c

# Discover module (new)
DISCOVER_SRCS = \
    src/discover/language.c \
    src/discover/userconfig.c \
    src/discover/gitignore.c \
    src/discover/discover.c

# Graph buffer module (new)
GRAPH_BUFFER_SRCS = src/graph_buffer/graph_buffer.c

# Pipeline module (new)
PIPELINE_SRCS = \
    src/pipeline/fqn.c \
    src/pipeline/path_alias.c \
    src/pipeline/registry.c \
    src/pipeline/source_snapshot.c \
    src/pipeline/structured_data.c \
    src/pipeline/pipeline.c \
    src/pipeline/pipeline_incremental.c \
    src/pipeline/worker_pool.c \
    src/pipeline/pass_parallel.c \
    src/pipeline/pass_definitions.c \
    src/pipeline/pass_calls.c \
    src/pipeline/pass_lsp_cross.c \
    src/pipeline/pass_usages.c \
    src/pipeline/pass_semantic.c \
    src/pipeline/pass_tests.c \
    src/pipeline/pass_githistory.c \
    src/pipeline/pass_gitdiff.c \
    src/pipeline/pass_configures.c \
    src/pipeline/pass_configlink.c \
    src/pipeline/pass_route_nodes.c \
    src/pipeline/pass_enrichment.c \
    src/pipeline/pass_compile_commands.c \
    src/pipeline/pass_infrascan.c \
    src/pipeline/pass_k8s.c \
    src/pipeline/pass_similarity.c \
    src/pipeline/pass_semantic_edges.c \
    src/pipeline/pass_complexity.c \
    src/pipeline/pass_cross_repo.c \
    src/pipeline/artifact.c \
    src/pipeline/pass_pkgmap.c

# SimHash / MinHash module
SIMHASH_SRCS = src/simhash/minhash.c

# Semantic embedding module
SEMANTIC_SRCS = src/semantic/semantic.c src/semantic/ast_profile.c src/semantic/rotsq.c

# nomic-embed-code pretrained vectors (assembler blob)
UNIXCODER_BLOB_SRC = vendored/nomic/code_vectors_blob.S

# Traces module (new)
TRACES_SRCS = src/traces/traces.c src/traces/otlp_decode.c src/traces/trace_ingest.c

# Watcher module (new)
WATCHER_SRCS = src/watcher/watcher.c

# Git context module (new)
GIT_SRCS = src/git/git_context.c

# CLI module (new)
CLI_SRCS = src/cli/cli.c src/cli/progress_sink.c src/cli/hook_augment.c

# UI module (graph visualization)
UI_SRCS = \
    src/ui/config.c \
    src/ui/http_server.c \
    src/ui/layout3d.c \
    src/ui/httpd.c \
    src/ui/embedded_stub.c

# mimalloc (vendored; global allocator override on MinGW only)
#
# Routing is platform-specific:
#  * Unix (macOS/Linux): ordinary CBM C allocation remains on libc. Defining
#    MI_MALLOC_OVERRIDE would make this binary's free == mi_free while system
#    libraries keep allocating through the platform allocator; pointers crossing
#    that boundary caused "mi_free: invalid pointer" aborts on macOS. Rust plus
#    the explicitly bound tree-sitter/SQLite paths still use this mimalloc object.
#  * Windows (MinGW, static CRT): define MI_MALLOC_OVERRIDE=1 to compile the
#    static-CRT override added in mimalloc 3.3.0 (the _MSC_VER / _ACRTIMP /
#    _CRT_HYBRIDPATCHABLE entry points) which take precedence over the static
#    CRT's malloc/free.
# Note: mimalloc's source gates the override body on MI_MALLOC_OVERRIDE (CMake
# derives it from the MI_OVERRIDE option); MI_OVERRIDE alone is not read by the
# source — it is kept here only as this project's prod/test marker.
MIMALLOC_SRC = vendored/mimalloc/src/static.c
MIMALLOC_OVERRIDE_DEFINE :=
ifeq ($(IS_MINGW),yes)
MIMALLOC_OVERRIDE_DEFINE := -DMI_MALLOC_OVERRIDE=1
endif
MIMALLOC_CFLAGS = -std=c11 -O2 -w \
                  -Ivendored/mimalloc/include \
                  -Ivendored/mimalloc/src \
                  -DMI_OVERRIDE=1 \
                  $(MIMALLOC_OVERRIDE_DEFINE)
# Debug/-O1, MI_OVERRIDE=0 mimalloc flags. The C test suite that named this
# variable is gone (#397); it is retained because the LIBCBM_ASAN libcbm build
# below consumes it (LIBCBM_MIMALLOC_CFLAGS) for the ASan-instrumented archive.
MIMALLOC_CFLAGS_TEST = -std=c11 -g -O1 -w \
                       -Ivendored/mimalloc/include \
                       -Ivendored/mimalloc/src \
                       -DMI_OVERRIDE=0

# sqlite3 (vendored amalgamation — compiled ourselves for ASan instrumentation)
# SQLITE_ENABLE_FTS5: enables the FTS5 full-text search extension used by the
# BM25 search path in search_graph (see nodes_fts virtual table in store.c).
SQLITE3_SRC = vendored/sqlite3/sqlite3.c
SQLITE3_CFLAGS = -std=c11 -O2 -w -DSQLITE_DQS=0 -DSQLITE_THREADSAFE=1 -DSQLITE_ENABLE_FTS5

# TRE regex (vendored, Windows only — POSIX uses system <regex.h>)
TRE_SRC = vendored/tre/tre_all.c
TRE_CFLAGS = -std=c11 -g -O1 -w -Ivendored/tre

# yyjson (vendored)
YYJSON_SRC = vendored/yyjson/yyjson.c

# All production sources
PROD_SRCS = $(FOUNDATION_SRCS) $(STORE_SRCS) $(CYPHER_SRCS) $(MCP_SRCS) $(DISCOVER_SRCS) $(GRAPH_BUFFER_SRCS) $(PIPELINE_SRCS) $(SIMHASH_SRCS) $(SEMANTIC_SRCS) $(TRACES_SRCS) $(WATCHER_SRCS) $(GIT_SRCS) $(CLI_SRCS) $(UI_SRCS) $(YYJSON_SRC)
EXISTING_C_SRCS = $(EXTRACTION_SRCS) $(LSP_SRCS) $(TS_RUNTIME_SRC) \
                  $(GRAMMAR_SRCS) $(AC_LZ4_SRCS) $(ZSTD_SRCS) $(SQLITE_WRITER_SRC)

# ── Astrolabe-owned overlays are compile-time features of the CBM sources ─────
# The former patches/cbm appliers were absorbed into the CBM sources as plain
# edits, guarded by ASTRO_* macros so each artifact selects the exact behavior
# it had before the overlay machinery was dissolved (issue #286). Which flag
# reaches which artifact:
#   libcbm.a          : ASTRO_ENV_STORE, ASTRO_SPAWN, ASTRO_SHELLARG,
#                       ASTRO_MEM_PRESSURE, ASTRO_WORKER_DIAG  (see LIBCBM_CFLAGS)
#   cbm / cbm-with-ui : ASTRO_WORKER_DIAG                      (ASTRO_PROD_DEFS)
#   test-runner       : none — the vendored behavior, unpatched
# The production binaries compile the owned sources directly (no path
# substitution); the flag below turns on the diagnostics feature that
# historically reached them. #282 (worker-failure diagnostics, live parity with
# the astrolabe/libcbm side).
#
# #273: the former ASTRO_UI_WERROR macro is gone. Its #229 -Werror root-cause
# fixes (src/ui/layout3d.c and src/pipeline/pass_definitions.c unchecked
# allocation-size guards) are now UNCONDITIONAL in
# the CBM sources, so they ship identically in libcbm.a, the production binaries,
# and the test-runner — no per-artifact macro gates them, and the blanket
# -Wno-stringop-truncation / -Wno-alloc-size-larger-than that used to mask them on
# the unguarded paths are removed (see GCC_ONLY_FLAGS above).
ASTRO_PROD_DEFS = -DASTRO_WORKER_DIAG

# ── Build directories ────────────────────────────────────────────

BUILD_DIR = build/c
AR ?= ar
LD ?= ld
NM ?= nm
OBJDUMP ?= objdump
UNAME_S := $(shell uname -s)
NO_EXECSTACK_LD_FLAG :=
ifeq ($(UNAME_S),Linux)
NO_EXECSTACK_LD_FLAG := -z noexecstack
endif

# ── Object file compilation (grammars need relaxed warnings) ─────

# Grammar + tree-sitter runtime: compiled without -Werror (upstream code has warnings)
# $(GRAMMAR_SUBSET_DEFS) carries the #283 grammar-subset selectors
# (-DCBM_GRAMMAR_SET_CORE + -DCBM_CORE_<lang> ...) into grammar_stubs.c; empty in
# a full build, so those compiles are byte-identical to prior behavior.
GRAMMAR_CFLAGS = -std=c11 -D_DEFAULT_SOURCE -O2 -w -I$(CBM_DIR) -I$(TS_INCLUDE) -I$(TS_SRC) \
                 $(GRAMMAR_SUBSET_DEFS)
LSP_CFLAGS = $(GRAMMAR_CFLAGS) -Isrc

# ── Targets ──────────────────────────────────────────────────────

.PHONY: libcbm cbm cbm-with-ui frontend embed clean-c lint lint-tidy lint-cppcheck lint-cppcheck-astrolabe lint-format security astro-cc-family-probe

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# #274 regression probe: prints the classified compiler family and the derived
# IS_GCC without compiling anything. A determinism check invokes this repeatedly
# (and with each build goal) to assert the values are identical across
# invocations and across the cbm / cbm-with-ui / libcbm build contexts, which all
# consume the single parse-time IS_GCC assignment above.
astro-cc-family-probe:
	@echo "CC_FAMILY=$(CC_FAMILY) IS_GCC=$(IS_GCC)"

# ── Production vendored object files ──────────────────────────────

# mimalloc object file
MIMALLOC_OBJ_PROD = $(BUILD_DIR)/prod_mimalloc.o

$(BUILD_DIR)/prod_mimalloc.o: $(MIMALLOC_SRC) | $(BUILD_DIR)
	$(CC) $(MIMALLOC_CFLAGS) -c -o $@ $<

# sqlite3 object file (vendored amalgamation)
SQLITE3_OBJ_PROD = $(BUILD_DIR)/prod_sqlite3.o

$(BUILD_DIR)/prod_sqlite3.o: $(SQLITE3_SRC) | $(BUILD_DIR)
	$(CC) $(SQLITE3_CFLAGS) -c -o $@ $<

# TRE regex (only compiled on Windows — POSIX uses system <regex.h>)
TRE_OBJ_PROD :=
ifeq ($(IS_MINGW),yes)
TRE_OBJ_PROD = $(BUILD_DIR)/prod_tre.o

$(BUILD_DIR)/prod_tre.o: $(TRE_SRC) | $(BUILD_DIR)
	$(CC) $(TRE_CFLAGS) -O2 -c -o $@ $<
endif

# nomic-embed-code pretrained vector blob
UNIXCODER_OBJ = $(BUILD_DIR)/unixcoder_blob.o
$(UNIXCODER_OBJ): $(UNIXCODER_BLOB_SRC) vendored/nomic/code_vectors.bin | $(BUILD_DIR)
	$(CC) -c -o $@ $<

# ── Production binary ────────────────────────────────────────────

# Grammar/TS/LSP objects for production (compiled with relaxed warnings, -O2)
GRAMMAR_OBJS_PROD = $(patsubst $(CBM_DIR)/%.c,$(BUILD_DIR)/prod_%.o,$(GRAMMAR_SRCS))
TS_RUNTIME_OBJ_PROD = $(BUILD_DIR)/prod_ts_runtime.o
LSP_OBJ_PROD = $(BUILD_DIR)/prod_lsp_all.o

$(BUILD_DIR)/prod_%.o: $(CBM_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(GRAMMAR_CFLAGS) -c -o $@ $<

$(BUILD_DIR)/prod_ts_runtime.o: $(CBM_DIR)/ts_runtime.c | $(BUILD_DIR)
	$(CC) $(GRAMMAR_CFLAGS) -c -o $@ $<

$(BUILD_DIR)/prod_lsp_all.o: $(LSP_UNITY_DEPS) | $(BUILD_DIR)
	$(CC) $(LSP_CFLAGS) -c -o $@ $<

# Vendored LZ4 (compiled separately, not unity-built via lz4_store.c)
LZ4_OBJ_PROD = $(BUILD_DIR)/prod_lz4.o $(BUILD_DIR)/prod_lz4hc.o
$(BUILD_DIR)/prod_lz4.o: $(CBM_DIR)/vendored/lz4/lz4.c | $(BUILD_DIR)
	$(CC) -std=c11 -D_DEFAULT_SOURCE -O2 -w -I$(CBM_DIR) -c -o $@ $<
$(BUILD_DIR)/prod_lz4hc.o: $(CBM_DIR)/vendored/lz4/lz4hc.c | $(BUILD_DIR)
	$(CC) -std=c11 -D_DEFAULT_SOURCE -O2 -w -I$(CBM_DIR)/vendored/lz4 -c -o $@ $<

# Vendored zstd (compiled separately, not unity-built via zstd_store.c)
ZSTD_OBJ_PROD = $(BUILD_DIR)/prod_zstd.o
$(BUILD_DIR)/prod_zstd.o: $(CBM_DIR)/vendored/zstd/zstd.c | $(BUILD_DIR)
	$(CC) -std=c11 -D_DEFAULT_SOURCE -O2 -w -I$(CBM_DIR)/vendored/zstd -c -o $@ $<

OBJS_VENDORED_PROD = $(MIMALLOC_OBJ_PROD) $(SQLITE3_OBJ_PROD) $(TRE_OBJ_PROD) $(GRAMMAR_OBJS_PROD) $(TS_RUNTIME_OBJ_PROD) $(LSP_OBJ_PROD) $(LZ4_OBJ_PROD) $(ZSTD_OBJ_PROD) $(UNIXCODER_OBJ)

MAIN_SRC = src/main.c

# The production binary compiles the owned sources directly; ASTRO_PROD_DEFS
# turns on the #229 -Werror root-cause fixes and the #282 worker diagnostics.
# #280: per-TU objects with -MMD dep tracking — the historical single gcc
# command (~320s serial) dominated the mcp-parity gate on any cache miss;
# per-TU objects make the cold build -j-parallel and an edit incremental.
# Same pattern as the owned vendor Makefile.cbm.
PROD_TU_SRCS = $(MAIN_SRC) $(PROD_SRCS) $(EXTRACTION_SRCS) $(AC_LZ4_SRCS) $(ZSTD_SRCS) $(SQLITE_WRITER_SRC)
PROD_TU_OBJS = $(patsubst %.c,$(BUILD_DIR)/tuprod/%.o,$(PROD_TU_SRCS))

$(BUILD_DIR)/tuprod/%.o: %.c
	@mkdir -p $(@D)
	$(CC) $(CFLAGS_PROD) $(ASTRO_PROD_DEFS) -MMD -MP -c -o $@ $<

-include $(PROD_TU_OBJS:.o=.d)

$(BUILD_DIR)/codebase-memory-mcp: $(PROD_TU_OBJS) $(OBJS_VENDORED_PROD) | $(BUILD_DIR)
	$(file >$@.rsp,$(PROD_TU_OBJS) $(OBJS_VENDORED_PROD))
	$(CC) $(CFLAGS_PROD) $(ASTRO_PROD_DEFS) -o $@ @$@.rsp $(LDFLAGS)

cbm: $(BUILD_DIR)/codebase-memory-mcp
	@echo "Built: $(BUILD_DIR)/codebase-memory-mcp"

# ── Static library for Astrolabe FFI ─────────────────────────────

# ASTROLABE_PATCH_DIR is captured at the top of this file (before any -include).
ASTRO_ALLOC_SHIM_SRC = $(ASTROLABE_PATCH_DIR)/astro_alloc_shim.c
ASTRO_ALLOC_SHIM_OBJ = $(LIBCBM_DIR)/astro_alloc_shim.o
ASTRO_LAYOUT_PROBE_SRC = $(ASTROLABE_PATCH_DIR)/astro_layout_probe.c
ASTRO_LAYOUT_PROBE_OBJ = $(LIBCBM_DIR)/astro_layout_probe.o
ASTRO_FFI_INCLUDE_DIR = $(ASTROLABE_PATCH_DIR)/../../crates/cbm-sys/include
ASTRO_FFI_HEADER = $(ASTRO_FFI_INCLUDE_DIR)/astro_ffi.h
LIBCBM_BINDINGS = $(ASTROLABE_PATCH_DIR)/../../crates/cbm-sys/src/bindings.rs
LIBCBM_EXPORT_CONTRACT = $(ASTROLABE_PATCH_DIR)/libcbm_export_contract.py
# ── #240/#241: store-resolution facilities (now compiled unconditionally) ─────
# Astrolabe-owned store configuration (explicit FFI parameter instead of
# env-as-IPC) plus the fail-closed environment fault record. The CBM resolvers
# that consume them are edited in place under ASTRO_ENV_STORE; libcbm defines
# that flag (LIBCBM_CFLAGS), so this translation unit is always linked into the
# archive. ASTRO_ENV_STORE_INC puts its header on the include path.
ASTRO_ENV_STORE_CONFIG_SRC = $(ASTROLABE_PATCH_DIR)/env_store_config.c
ASTRO_ENV_STORE_CONFIG_HDR = $(ASTROLABE_PATCH_DIR)/env_store_config.h
ASTRO_ENV_STORE_CONFIG_OBJ = $(LIBCBM_DIR)/env_store_config.o
ASTRO_ENV_STORE_INC = -I$(ASTROLABE_PATCH_DIR)

PYTHON ?= python
LIBCBM_DIR = $(BUILD_DIR)/libcbm
LIBCBM_CONFIG_STAMP ?=
LIBCBM_SRCS = $(PROD_SRCS) $(EXTRACTION_SRCS) $(AC_LZ4_SRCS) $(ZSTD_SRCS) $(SQLITE_WRITER_SRC) \
              $(GRAMMAR_SRCS) $(TS_RUNTIME_SRC) $(CBM_DIR)/lsp_all.c \
              $(MIMALLOC_SRC) $(SQLITE3_SRC) $(CBM_DIR)/vendored/lz4/lz4.c \
              $(CBM_DIR)/vendored/lz4/lz4hc.c $(CBM_DIR)/vendored/zstd/zstd.c
ifeq ($(IS_MINGW),yes)
LIBCBM_SRCS += $(TRE_SRC)
endif
LIBCBM_C_OBJS = $(patsubst %.c,$(LIBCBM_DIR)/%.o,$(filter %.c,$(LIBCBM_SRCS)))
LIBCBM_CXX_OBJS = $(patsubst %.cpp,$(LIBCBM_DIR)/%.o,$(filter %.cpp,$(LIBCBM_SRCS)))
LIBCBM_ASM_OBJS = $(patsubst %.S,$(LIBCBM_DIR)/%.o,$(UNIXCODER_BLOB_SRC))
LIBCBM_OBJS = $(LIBCBM_C_OBJS) $(LIBCBM_CXX_OBJS) $(LIBCBM_ASM_OBJS) $(ASTRO_ALLOC_SHIM_OBJ) $(ASTRO_LAYOUT_PROBE_OBJ) $(ASTRO_ENV_STORE_CONFIG_OBJ)
# Compiler depfiles cover transitive includes; the config stamp covers command
# inputs that Make cannot infer from source timestamps.
LIBCBM_DEPFILES = $(LIBCBM_OBJS:.o=.d)
LIBCBM_DEPFLAGS = -MMD -MP
LIBCBM_CFLAGS = $(CFLAGS_PROD) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_CXXFLAGS = $(CXXFLAGS_PROD) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_GRAMMAR_CFLAGS = $(GRAMMAR_CFLAGS) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_LSP_CFLAGS = $(LSP_CFLAGS) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_SQLITE3_CFLAGS = $(SQLITE3_CFLAGS) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_MIMALLOC_CFLAGS = $(MIMALLOC_CFLAGS) -fvisibility=hidden -DCBM_BUILDING_LIB=1
ifeq ($(LIBCBM_ASAN),1)
LIBCBM_CFLAGS = $(CFLAGS_COMMON) -g -O1 $(CFLAGS_EXTRA) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_CXXFLAGS = $(CXXFLAGS_COMMON) -g -O1 $(CXXFLAGS_EXTRA) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_GRAMMAR_CFLAGS = $(GRAMMAR_CFLAGS) -g -O1 $(CFLAGS_EXTRA) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_LSP_CFLAGS = $(LSP_CFLAGS) -g -O1 $(CFLAGS_EXTRA) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_SQLITE3_CFLAGS = $(SQLITE3_CFLAGS) $(CFLAGS_EXTRA) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_MIMALLOC_CFLAGS = $(MIMALLOC_CFLAGS_TEST) $(CFLAGS_EXTRA) -fvisibility=hidden -DCBM_BUILDING_LIB=1
endif
# libcbm is a static archive. Prevent every known PE export-directive producer
# at compilation rather than rewriting the 274 MB relocatable object afterward:
# CBM_API becomes an ordinary declaration, generated tree-sitter entry points
# stay link-visible without dllexport, and SQLite compiles its built-in extension
# path instead of loadable-extension entry points. The post-link contract below
# independently refuses any residual .drectve section.
LIBCBM_STATIC_DEFS = -DCBM_STATIC_LIB=1
LIBCBM_CFLAGS += $(LIBCBM_STATIC_DEFS)
LIBCBM_CXXFLAGS += $(LIBCBM_STATIC_DEFS)
LIBCBM_GRAMMAR_CFLAGS += $(LIBCBM_STATIC_DEFS) -DTREE_SITTER_HIDE_SYMBOLS=1
LIBCBM_LSP_CFLAGS += $(LIBCBM_STATIC_DEFS) -DTREE_SITTER_HIDE_SYMBOLS=1
LIBCBM_SQLITE3_CFLAGS += $(LIBCBM_STATIC_DEFS) -DSQLITE_CORE=1
LIBCBM_MIMALLOC_CFLAGS += $(LIBCBM_STATIC_DEFS)
LIBCBM_CFLAGS += $(LIBCBM_DEPFLAGS)
LIBCBM_CXXFLAGS += $(LIBCBM_DEPFLAGS)
LIBCBM_GRAMMAR_CFLAGS += $(LIBCBM_DEPFLAGS)
LIBCBM_LSP_CFLAGS += $(LIBCBM_DEPFLAGS)
LIBCBM_SQLITE3_CFLAGS += $(LIBCBM_DEPFLAGS)
LIBCBM_MIMALLOC_CFLAGS += $(LIBCBM_DEPFLAGS)

# ── Astrolabe overlay features absorbed into the CBM sources (#286) ───────────
# Every overlay that historically reached libcbm is now a plain edit in the
# owned CBM source, guarded by an ASTRO_* macro. libcbm defines them all here;
# the production binaries define only ASTRO_PROD_DEFS, the test-runner none —
# reproducing the pre-#286 per-artifact behavior matrix exactly.
# -I$(ASTROLABE_PATCH_DIR) resolves the two Astrolabe-owned headers those guarded
# regions include: env_store_config.h (ASTRO_ENV_STORE), astro_spawn.h (ASTRO_SPAWN).
LIBCBM_ASTRO_DEFS = -DASTRO_ENV_STORE -DASTRO_SPAWN -DASTRO_SHELLARG \
                    -DASTRO_MEM_PRESSURE -DASTRO_WORKER_DIAG
LIBCBM_CFLAGS += $(LIBCBM_ASTRO_DEFS) -I$(ASTROLABE_PATCH_DIR)

# ── BEGIN Astrolabe #227/#228: shell-free git spawn helper ────────────────────
#
# #227: CBM's git helpers composed a command STRING for cbm_popen, which runs
# `cmd.exe /c <string>` on Windows (the CRT's _popen "executes a spawned copy of
# the command processor") and `/bin/sh -c <string>` on POSIX. cmd.exe performs
# %VAR% substitution and ^ escaping at PARSE time — before quoting applies — so
# no quoting of an interpolated repo path can make the string inert, and every
# new metacharacter class becomes another blocklist entry. These overlays route
# every git shell-out through cbm_spawn_capture (patches/cbm/astro_spawn.c),
# which spawns git with an explicit argv via CreateProcessW / posix_spawnp: no
# shell, therefore nothing to escape.
#
# #228: the C validator cbm_validate_shell_arg gains the Windows % ^ ! rejection
# the Rust bridge validator got in #136 (defence in depth, not the only barrier).
#
# Overlays are hash-checked and build-local: the generators read the pinned
# vendor bytes, verify their sha256, and write into $(LIBCBM_DIR). They never
# write into the cbm/ source tree.
ASTRO_SPAWN_SRC = $(ASTROLABE_PATCH_DIR)/astro_spawn.c
ASTRO_SPAWN_HDR = $(ASTROLABE_PATCH_DIR)/astro_spawn.h
ASTRO_SPAWN_OBJ = $(LIBCBM_DIR)/astro_spawn.o

# The spawn helper compiles as an ordinary libcbm object; it exports the single
# cbm_-prefixed symbol cbm_spawn_capture, so the libcbm export filter keeps it.
# The git shell-out sites in git_context.c / artifact.c / watcher.c /
# pass_githistory.c call into it under ASTRO_SPAWN, which libcbm defines.
LIBCBM_OBJS += $(ASTRO_SPAWN_OBJ)

$(ASTRO_SPAWN_OBJ): $(ASTRO_SPAWN_SRC) $(ASTRO_SPAWN_HDR) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) -I$(ASTROLABE_PATCH_DIR) -c -o $@ $<

# Format-check the two Astrolabe-owned spawn TUs (they live outside the CBM
# source dirs, so feed via stdin with a vendor-relative assumed name to resolve
# the CBM .clang-format). The edited CBM sources are format-checked in place by
# the ordinary ASTRO_LINT_FORMAT_SRCS pass.
lint-format-astrolabe: astro-lint-format-spawn

astro-lint-format-spawn:
	@echo "=== clang-format (Astrolabe spawn helper) ==="
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror \
		--assume-filename=src/foundation/astro_spawn.c < $(ASTRO_SPAWN_SRC)
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror \
		--assume-filename=src/foundation/astro_spawn.h < $(ASTRO_SPAWN_HDR)
# ── END Astrolabe #227/#228 ───────────────────────────────────────────────────

ifneq ($(strip $(LIBCBM_CONFIG_STAMP)),)
$(LIBCBM_OBJS): $(LIBCBM_CONFIG_STAMP)
endif

-include $(LIBCBM_DEPFILES)

LIBCBM_A = $(BUILD_DIR)/libcbm.a
LIBCBM_RELOC = $(BUILD_DIR)/libcbm.o
LIBCBM_EXPORTS = $(BUILD_DIR)/libcbm.exports
LIBCBM_OBJECTS_RSP = $(BUILD_DIR)/libcbm.objects.rsp
LIBCBM_EXPORT_AUDIT = $(BUILD_DIR)/libcbm.exports.audit.json
LIBCBM_LOCALIZATION_AUDIT = $(BUILD_DIR)/libcbm.localization.audit.json
LIBCBM_RELOC_AUDIT = $(BUILD_DIR)/libcbm.reloc.audit.json
LIBCBM_ARCHIVE_AUDIT = $(BUILD_DIR)/libcbm.archive.audit.json

$(LIBCBM_DIR)/$(CBM_DIR)/grammar_%.o: $(CBM_DIR)/grammar_%.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_GRAMMAR_CFLAGS) -c -o $@ $<

$(LIBCBM_DIR)/$(CBM_DIR)/ts_runtime.o: $(CBM_DIR)/ts_runtime.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_GRAMMAR_CFLAGS) -c -o $@ $<

$(LIBCBM_DIR)/$(CBM_DIR)/lsp_all.o: $(LSP_UNITY_DEPS) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_LSP_CFLAGS) -c -o $@ $<

$(LIBCBM_DIR)/$(MIMALLOC_SRC:.c=.o): $(MIMALLOC_SRC) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_MIMALLOC_CFLAGS) -c -o $@ $<

$(ASTRO_ALLOC_SHIM_OBJ): $(ASTRO_ALLOC_SHIM_SRC) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) -Ivendored/mimalloc/include -Ivendored/mimalloc/src -c -o $@ $<

$(ASTRO_LAYOUT_PROBE_OBJ): $(ASTRO_LAYOUT_PROBE_SRC) $(ASTRO_FFI_HEADER) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) -I$(ASTRO_FFI_INCLUDE_DIR) -c -o $@ $<

# ── #240/#241: Astrolabe-owned store-configuration TU ─────────────
# env_store_config.c is a first-class Astrolabe object always linked into
# libcbm; the CBM resolvers call into it under ASTRO_ENV_STORE (defined for
# libcbm in LIBCBM_CFLAGS). The overlaid CBM sources (platform.c, pipeline.c,
# cli.c, mcp.c, http_server.c, index_supervisor.c, str_util.c, mem.c, watcher.c,
# git_context.c, artifact.c, pass_githistory.c) are edited in place and compile
# via the generic $(LIBCBM_DIR)/%.o rule below, which carries LIBCBM_CFLAGS
# (the ASTRO_* defines + -I$(ASTROLABE_PATCH_DIR) for env_store_config.h /
# astro_spawn.h). Their quote-includes resolve from the source's own directory.
$(ASTRO_ENV_STORE_CONFIG_OBJ): $(ASTRO_ENV_STORE_CONFIG_SRC) $(ASTRO_ENV_STORE_CONFIG_HDR) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) $(ASTRO_ENV_STORE_INC) -c -o $@ $<

$(LIBCBM_DIR)/$(SQLITE3_SRC:.c=.o): $(SQLITE3_SRC) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_SQLITE3_CFLAGS) -c -o $@ $<

$(LIBCBM_DIR)/$(TRE_SRC:.c=.o): $(TRE_SRC) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(TRE_CFLAGS) $(LIBCBM_DEPFLAGS) -O2 -fvisibility=hidden -c -o $@ $<

$(LIBCBM_DIR)/$(CBM_DIR)/vendored/lz4/%.o: $(CBM_DIR)/vendored/lz4/%.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_DEPFLAGS) -std=c11 -D_DEFAULT_SOURCE -O2 -fvisibility=hidden -w -I$(CBM_DIR) -I$(CBM_DIR)/vendored/lz4 -c -o $@ $<

$(LIBCBM_DIR)/$(CBM_DIR)/vendored/zstd/zstd.o: $(CBM_DIR)/vendored/zstd/zstd.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_DEPFLAGS) -std=c11 -D_DEFAULT_SOURCE -O2 -fvisibility=hidden -w -I$(CBM_DIR)/vendored/zstd -c -o $@ $<

$(LIBCBM_DIR)/%.o: %.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) -c -o $@ $<

$(LIBCBM_DIR)/%.o: %.cpp | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CXX) $(LIBCBM_CXXFLAGS) -c -o $@ $<

$(LIBCBM_DIR)/$(UNIXCODER_BLOB_SRC:.S=.o): $(UNIXCODER_BLOB_SRC) vendored/nomic/code_vectors.bin | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_DEPFLAGS) -fvisibility=hidden -c -o $@ $<

$(LIBCBM_DIR)/%.o: %.S | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_DEPFLAGS) -fvisibility=hidden -c -o $@ $<

$(LIBCBM_EXPORTS): $(LIBCBM_OBJS) $(LIBCBM_BINDINGS) $(LIBCBM_EXPORT_CONTRACT)
	$(file >$(LIBCBM_OBJECTS_RSP),$(LIBCBM_OBJS))
	$(PYTHON) $(LIBCBM_EXPORT_CONTRACT) prepare --nm "$(NM)" --objects-response $(LIBCBM_OBJECTS_RSP) --bindings $(LIBCBM_BINDINGS) --exports $@ --audit $(LIBCBM_EXPORT_AUDIT)

$(LIBCBM_RELOC): $(LIBCBM_OBJS) $(LIBCBM_EXPORTS) $(LIBCBM_EXPORT_CONTRACT)
	$(file >$(LIBCBM_OBJECTS_RSP),$(LIBCBM_OBJS))
	# PE aligned-common metadata also uses .drectve. -d assigns those commons
	# during this complete partial link, preserving their declared alignment and
	# making the consumed directives unnecessary in the relocatable output.
	$(LD) -r -d $(NO_EXECSTACK_LD_FLAG) $(MINGW_RELOC_LD_FLAGS) --retain-symbols-file $(LIBCBM_EXPORTS) -o $@ @$(LIBCBM_OBJECTS_RSP)
	# Cross-object relocations are now resolved inside one COFF object. Localize
	# every non-API definition by changing only its fixed symbol storage-class
	# byte, then prove the exact external projection independently. This avoids
	# generic objcopy's full-payload rewrite while preserving relocation indices.
	$(PYTHON) $(LIBCBM_EXPORT_CONTRACT) localize --reloc $@ --exports $(LIBCBM_EXPORTS) --audit $(LIBCBM_LOCALIZATION_AUDIT)
	$(PYTHON) $(LIBCBM_EXPORT_CONTRACT) verify --nm "$(NM)" --objdump "$(OBJDUMP)" --objects-response $(LIBCBM_OBJECTS_RSP) --reloc $@ --exports $(LIBCBM_EXPORTS) --audit $(LIBCBM_RELOC_AUDIT)

$(LIBCBM_A): $(LIBCBM_RELOC) $(LIBCBM_EXPORT_CONTRACT)
	rm -f $@
	# The D modifier is explicit: build reproducibility never depends on how the
	# pinned binutils package happened to configure ar's default mode.
	$(AR) rcsD $@ $(LIBCBM_RELOC)
	$(PYTHON) $(LIBCBM_EXPORT_CONTRACT) verify-archive --archive $@ --reloc $(LIBCBM_RELOC) --audit $(LIBCBM_ARCHIVE_AUDIT)

libcbm: $(LIBCBM_A)
	@echo "Built static library: $(LIBCBM_A)"

# ── Build with embedded UI (requires Node.js) ───────────────────

# #229 vendor-write containment: the UI build must leave the owned CBM source
# tree byte-clean (`git status --porcelain cbm`).
# graph-ui/dist and node_modules are gitignored, but two generated outputs
# otherwise land in the source tree: (a) the embed step's src/ui/embedded_assets.c
# (untracked, non-ignored), and (b) `tsc -b`'s TRACKED graph-ui/tsconfig.tsbuildinfo.
# Both are redirected below so every generated artifact stays under BUILD_DIR.
# Deferred (=) so $(BUILD_DIR) resolves to its final value at use time.
ASTRO_BUILD_DIR_ABS := $(abspath $(BUILD_DIR))
ASTRO_UI_EMBED_STAGE = $(ASTRO_BUILD_DIR_ABS)/astrolabe-ui-embed
ASTRO_UI_EMBEDDED_ASSETS_C = $(ASTRO_UI_EMBED_STAGE)/src/ui/embedded_assets.c
ASTRO_EMBED_SCRIPT = $(CURDIR)/scripts/embed-frontend.sh
ASTRO_GRAPH_UI_DIST_ABS = $(abspath graph-ui/dist)

# Swap embedded_stub.c for the generated (build-local) embedded_assets.c
UI_SRCS_WITH_ASSETS = $(subst src/ui/embedded_stub.c,$(ASTRO_UI_EMBEDDED_ASSETS_C),$(UI_SRCS))
PROD_SRCS_WITH_ASSETS = $(subst src/ui/embedded_stub.c,$(ASTRO_UI_EMBEDDED_ASSETS_C),$(PROD_SRCS))
# Embedded asset object files (generated by embed script)
EMBED_OBJS = $(wildcard $(ASTRO_BUILD_DIR_ABS)/embedded/embed_*.o)

# #229: build the frontend bundle WITHOUT the package.json `tsc -b` typecheck.
# `npm run build` = `tsc -b && vite build`; tsconfig.json sets noEmit:true, so
# `tsc -b` emits no JS — its sole artifact is the TRACKED graph-ui/tsconfig.tsbuildinfo,
# which dirties the owned source subtree. vite bundles graph-ui/dist (gitignored)
# with esbuild and never consumes tsc output, so the emitted assets are identical.
# Typecheck stays a concern of upstream CBM's own dev flow; the UI smoke needs only
# the runtime bundle and must not write into the source tree.
frontend:
	cd graph-ui && npm ci && npx vite build

# #229: run the vendored embed generator from a build-local staging root. The
# script hard-codes ASSETS_C="src/ui/embedded_assets.c" relative to its CWD, so
# running it from $(ASTRO_UI_EMBED_STAGE) puts embedded_assets.c under BUILD_DIR;
# object files already go to the absolute output dir. Then fail closed if anything
# was still written into the owned source subtree, or if the asset was not produced.
embed: frontend
	rm -rf $(ASTRO_UI_EMBED_STAGE)
	mkdir -p $(ASTRO_UI_EMBED_STAGE)/src/ui
	cd $(ASTRO_UI_EMBED_STAGE) && CC="$(CC)" bash $(ASTRO_EMBED_SCRIPT) $(ASTRO_GRAPH_UI_DIST_ABS) $(ASTRO_BUILD_DIR_ABS)/embedded
	@test ! -e $(CURDIR)/src/ui/embedded_assets.c || { echo "ASTRO #229 ERROR: embed wrote embedded_assets.c into the source subtree" >&2; exit 1; }
	@test -e $(ASTRO_UI_EMBEDDED_ASSETS_C) || { echo "ASTRO #229 ERROR: embed did not produce $(ASTRO_UI_EMBEDDED_ASSETS_C)" >&2; exit 1; }

# ASTRO_PROD_DEFS turns on the #229 -Werror root-cause fixes and #282 worker
# diagnostics in the owned sources (compiled directly, no substitution).
cbm-with-ui: embed $(OBJS_VENDORED_PROD)
	$(CC) $(CFLAGS_PROD) $(ASTRO_PROD_DEFS) -o $(BUILD_DIR)/codebase-memory-mcp \
		$(MAIN_SRC) $(PROD_SRCS_WITH_ASSETS) \
		$(EXTRACTION_SRCS) $(AC_LZ4_SRCS) $(ZSTD_SRCS) $(SQLITE_WRITER_SRC) \
		$(OBJS_VENDORED_PROD) \
		$(wildcard $(ASTRO_BUILD_DIR_ABS)/embedded/embed_*.o) \
		$(LDFLAGS)
	@echo "Built with UI: $(BUILD_DIR)/codebase-memory-mcp"

clean-c:
	rm -rf $(BUILD_DIR)

# ── Linting ─────────────────────────────────────────────────────

# clang-tidy and clang-format: use Homebrew LLVM on macOS, overridable via make args
# e.g. make lint-format CLANG_FORMAT=clang-format-18
LLVM_BIN := $(shell brew --prefix llvm 2>/dev/null)/bin
CLANG_TIDY ?= $(shell [ -x "$(LLVM_BIN)/clang-tidy" ] && echo "$(LLVM_BIN)/clang-tidy" || echo clang-tidy)
CLANG_FORMAT ?= $(shell [ -x "$(LLVM_BIN)/clang-format" ] && echo "$(LLVM_BIN)/clang-format" || echo clang-format)
CLANG_FORMAT_FOR_SHELL := $(subst \,/,$(CLANG_FORMAT))
CPPCHECK ?= cppcheck

# macOS SDK sysroot (needed for Homebrew LLVM to find system headers)
SYSROOT = $(shell xcrun --show-sdk-path 2>/dev/null)
SYSROOT_FLAG = $(if $(SYSROOT),-isysroot $(SYSROOT),)

# Our source files (excluding vendored, grammars, tree-sitter runtime)
LINT_SRCS = $(FOUNDATION_SRCS) $(STORE_SRCS) $(CYPHER_SRCS) $(MCP_SRCS) \
            $(DISCOVER_SRCS) $(GRAPH_BUFFER_SRCS) $(PIPELINE_SRCS) $(SIMHASH_SRCS) $(SEMANTIC_SRCS) \
            $(TRACES_SRCS) $(WATCHER_SRCS) $(CLI_SRCS) $(EXTRACTION_SRCS) $(AC_LZ4_SRCS) \
            $(ZSTD_SRCS) $(SQLITE_WRITER_SRC) $(MAIN_SRC)
LINT_HDRS = $(wildcard src/**/*.h src/*.h $(CBM_DIR)/*.h)
# The CBM sources are owned and edited in place (issue #286), so they are
# format-checked directly as part of LINT_SRCS — no generated overlays.
ASTRO_LINT_FORMAT_SRCS = $(LINT_SRCS)
# clang-format resolves its style file by walking up from the assumed filename,
# and this Makefile always runs with the CBM root as the working directory, so an
# in-tree assumed name is what makes ./.clang-format the effective config for the
# two Astrolabe-owned TUs that still live outside the CBM src tree.
ASTRO_ENV_STORE_CONFIG_ASSUMED_C = src/foundation/env_store_config.c
ASTRO_ENV_STORE_CONFIG_ASSUMED_H = src/foundation/env_store_config.h

# clang-tidy: deep static analysis (config in .clang-tidy)
lint-tidy:
	@echo "=== clang-tidy ==="
	@$(CLANG_TIDY) --quiet $(LINT_SRCS) -- $(CFLAGS_COMMON) $(SYSROOT_FLAG)

# cppcheck: complementary analysis (config in .cppcheck)
lint-cppcheck:
	@echo "=== cppcheck ==="
	@$(CPPCHECK) --enable=warning,style,performance,portability \
		--std=c11 --language=c \
		--suppressions-list=.cppcheck \
		--error-exitcode=1 \
		--inline-suppr \
		--quiet \
		--suppress=varFuncNullUB \
		--suppress=intToPointerCast \
		--suppress=unusedStructMember \
		--suppress=nullPointerOutOfMemory \
		--suppress=nullPointerArithmeticOutOfMemory \
		--suppress=ctunullpointerOutOfMemory \
		--suppress='nullPointer:internal/cbm/sqlite_writer.c' \
		-Isrc -Ivendored -Ivendored/sqlite3 \
		-I$(CBM_DIR) -I$(TS_INCLUDE) \
		$(LINT_SRCS)

# cppcheck for Astrolabe-owned CBM C (#250): the vendored lint-cppcheck analyzes
# only $(LINT_SRCS) (vendored). The Astrolabe-authored patches/cbm/*.c files are
# the new-code surface most worth static analysis, but previously got clang-format
# only. Same analyzer policy and suppressions as the vendored recipe so findings
# stay directly comparable across the two source sets; varFuncNullUB is suppressed
# here for the same reason it is upstream — cbm_log_error(...) is a sentinel-
# terminated variadic macro (foundation/log.h: cbm_log(..., ##__VA_ARGS__, NULL)),
# so the "NULL after last typed arg" finding is a false positive on every call
# site, vendored or Astrolabe-owned. A real defect (e.g. a memory leak) is still
# caught — see the control proof in #250.
ASTRO_CPPCHECK_SRCS = $(ASTRO_ALLOC_SHIM_SRC) $(ASTRO_LAYOUT_PROBE_SRC) \
                      $(ASTRO_SPAWN_SRC) $(ASTRO_ENV_STORE_CONFIG_SRC)

lint-cppcheck-astrolabe:
	@echo "=== cppcheck (Astrolabe-owned CBM C #250) ==="
	@$(CPPCHECK) --enable=warning,style,performance,portability \
		--std=c11 --language=c \
		--suppressions-list=.cppcheck \
		--error-exitcode=1 \
		--inline-suppr \
		--quiet \
		--suppress=varFuncNullUB \
		--suppress=intToPointerCast \
		--suppress=unusedStructMember \
		--suppress=nullPointerOutOfMemory \
		--suppress=nullPointerArithmeticOutOfMemory \
		--suppress=ctunullpointerOutOfMemory \
		-Isrc -Ivendored -Ivendored/sqlite3 \
		-I$(CBM_DIR) -I$(TS_INCLUDE) \
		-I$(ASTROLABE_PATCH_DIR) -I$(ASTRO_FFI_INCLUDE_DIR) \
		$(ASTRO_CPPCHECK_SRCS)

# clang-format: formatting check (config in .clang-format, dry-run = no changes)
lint-format:
	@echo "=== clang-format ==="
	@$(CLANG_FORMAT) --dry-run --Werror $(LINT_SRCS) $(LINT_HDRS)

# The CBM sources are owned and edited in place (#286), so they format-check
# directly. Only the two Astrolabe-owned TUs that still live outside the CBM src
# tree (env_store_config.{c,h}) need the assume-filename stdin form so
# ./.clang-format applies. The spawn helper is handled by astro-lint-format-spawn.
lint-format-astrolabe:
	@echo "=== clang-format (Astrolabe-owned CBM sources) ==="
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror $(ASTRO_LINT_FORMAT_SRCS) $(LINT_HDRS)
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror --assume-filename=$(ASTRO_ENV_STORE_CONFIG_ASSUMED_C) < $(ASTRO_ENV_STORE_CONFIG_SRC)
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror --assume-filename=$(ASTRO_ENV_STORE_CONFIG_ASSUMED_H) < $(ASTRO_ENV_STORE_CONFIG_HDR)

# Ban ALL NOLINT variants EXCEPT whitelisted NOLINT(misc-no-recursion).
# The whitelist is in src/foundation/recursion_whitelist.h with documented reasoning.
# Rule: NOLINT(misc-no-recursion) is allowed ONLY on function definitions that are
# listed in recursion_whitelist.h. All other NOLINT forms are banned.
lint-no-suppress:
	@echo "=== NOLINT check ==="
	@if grep -rn 'NOLINT' src/ internal/cbm/*.c internal/cbm/*.h 2>/dev/null \
		| grep -v vendored \
		| grep -v 'NOLINT(misc-no-recursion)' \
		| grep -v 'recursion_whitelist.h'; then \
		echo "ERROR: Banned NOLINT comment found in source code."; \
		echo "Only NOLINT(misc-no-recursion) is allowed, and only for whitelisted functions."; \
		echo "See src/foundation/recursion_whitelist.h for the whitelist."; \
		exit 1; \
	fi
	@echo "  Checking NOLINT(misc-no-recursion) against whitelist..."
	@scripts/check-nolint-whitelist.sh

# All linters (run with make -j3 lint for parallel execution)
lint: lint-tidy lint-cppcheck lint-format lint-no-suppress
	@echo "=== All linters passed ==="

# CI linters (no clang-tidy — platform-dependent, enforced locally via pre-commit)
lint-ci: lint-cppcheck lint-format lint-no-suppress
	@echo "=== CI linters passed ==="

# ── Security audit (6 layers) ────────────────────────────────────

# Run all security checks: static audit, binary strings, UI, install, network
# Requires: production binary already built (make cbm)
security: cbm
	@echo "=== Running security audit suite ==="
	scripts/security-audit.sh
	scripts/security-strings.sh $(BUILD_DIR)/codebase-memory-mcp
	scripts/security-ui.sh
	scripts/security-install.sh $(BUILD_DIR)/codebase-memory-mcp
	scripts/security-network.sh $(BUILD_DIR)/codebase-memory-mcp
	scripts/security-vendored.sh
	@echo "=== All security checks passed ==="
