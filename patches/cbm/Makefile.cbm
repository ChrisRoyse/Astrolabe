    tests/repro/repro_lsp_c_cpp.c \
    tests/repro/repro_lsp_go_py.c \
    tests/repro/repro_lsp_ts.c \
    tests/repro/repro_ts_inherited_method.c \
    tests/repro/repro_lsp_java_cs.c \
    tests/repro/repro_lsp_kt_php_rust.c

ALL_TEST_SRCS =$(TEST_FOUNDATION_SRCS) $(TEST_EXTRACTION_SRCS) $(TEST_STORE_SRCS) $(TEST_CYPHER_SRCS) $(TEST_MCP_SRCS) $(TEST_DISCOVER_SRCS) $(TEST_GRAPH_BUFFER_SRCS) $(TEST_PIPELINE_SRCS) $(TEST_WATCHER_SRCS) $(TEST_LZ4_SRCS) $(TEST_ZSTD_SRCS) $(TEST_ARTIFACT_SRCS) $(TEST_SQLITE_WRITER_SRCS) $(TEST_GO_LSP_SRCS) $(TEST_C_LSP_SRCS) $(TEST_PHP_LSP_SRCS) $(TEST_CS_LSP_SRCS) $(TEST_CS_LSP_BENCH_SRCS) $(TEST_SCOPE_SRCS) $(TEST_TYPE_REP_SRCS) $(TEST_PY_LSP_SRCS) $(TEST_PY_LSP_BENCH_SRCS) $(TEST_PY_LSP_STRESS_SRCS) $(TEST_PY_LSP_SCALE_SRCS) $(TEST_TS_LSP_SRCS) $(TEST_JAVA_LSP_SRCS) $(TEST_KOTLIN_LSP_SRCS) $(TEST_RUST_LSP_SRCS) $(TEST_TRACES_SRCS) $(TEST_CLI_SRCS) $(TEST_MEM_SRCS) $(TEST_UI_SRCS) $(TEST_HTTPD_SRCS) $(TEST_SECURITY_SRCS) $(TEST_YAML_SRCS) $(TEST_SEMANTIC_SRCS) $(TEST_AST_PROFILE_SRCS) $(TEST_SLAB_ALLOC_SRCS) $(TEST_SIMHASH_SRCS) $(TEST_STACK_OVERFLOW_SRCS) $(TEST_INTEGRATION_SRCS)


# ── Build directories ────────────────────────────────────────────

BUILD_DIR = build/c
AR ?= ar
LD ?= ld
NM ?= nm
OBJCOPY ?= $(shell command -v objcopy 2>/dev/null || command -v llvm-objcopy 2>/dev/null || echo objcopy)
UNAME_S := $(shell uname -s)
NO_EXECSTACK_LD_FLAG :=
ifeq ($(UNAME_S),Linux)
NO_EXECSTACK_LD_FLAG := -z noexecstack
endif

# ── Object file compilation (grammars need relaxed warnings) ─────

# Grammar + tree-sitter runtime: compiled without -Werror (upstream code has warnings)
GRAMMAR_CFLAGS = -std=c11 -D_DEFAULT_SOURCE -O2 -w -I$(CBM_DIR) -I$(TS_INCLUDE) -I$(TS_SRC)
GRAMMAR_CFLAGS_TEST = -std=c11 -D_DEFAULT_SOURCE -g -O1 -w -I$(CBM_DIR) -I$(TS_INCLUDE) -I$(TS_SRC) \
                      $(SANITIZE)
GRAMMAR_CFLAGS_TSAN = -std=c11 -D_DEFAULT_SOURCE -g -O1 -w -I$(CBM_DIR) -I$(TS_INCLUDE) -I$(TS_SRC) \
                      -fsanitize=thread -fno-omit-frame-pointer

# Object files for grammars + ts_runtime + lsp_all + preprocessor
GRAMMAR_OBJS_TEST = $(patsubst $(CBM_DIR)/%.c,$(BUILD_DIR)/%.o,$(GRAMMAR_SRCS))
TS_RUNTIME_OBJ_TEST = $(BUILD_DIR)/ts_runtime.o
LSP_OBJ_TEST = $(BUILD_DIR)/lsp_all.o
PP_OBJ_TEST = $(BUILD_DIR)/preprocessor.o

# ── Targets ──────────────────────────────────────────────────────

.PHONY: test test-repro test-foundation test-tsan libcbm cbm cbm-with-ui frontend embed clean-c lint lint-tidy lint-cppcheck lint-cppcheck-astrolabe lint-format security

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# ── Foundation-only test (fast, no extraction) ───────────────────

$(BUILD_DIR)/test-foundation: $(TEST_FOUNDATION_SRCS) $(FOUNDATION_SRCS) | $(BUILD_DIR)
	$(CC) $(CFLAGS_TEST) -o $@ $(TEST_FOUNDATION_SRCS) $(FOUNDATION_SRCS) $(LDFLAGS_TEST)

test-foundation: $(BUILD_DIR)/test-foundation
	cd $(CURDIR) && $(BUILD_DIR)/test-foundation

# ── Grammar/TS/LSP object files (compiled with relaxed warnings) ─

$(BUILD_DIR)/%.o: $(CBM_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(GRAMMAR_CFLAGS_TEST) -c -o $@ $<

$(BUILD_DIR)/ts_runtime.o: $(CBM_DIR)/ts_runtime.c | $(BUILD_DIR)
	$(CC) $(GRAMMAR_CFLAGS_TEST) -c -o $@ $<

$(BUILD_DIR)/lsp_all.o: $(LSP_UNITY_DEPS) | $(BUILD_DIR)
	$(CC) $(GRAMMAR_CFLAGS_TEST) $(SANITIZE) -c -o $@ $<

$(BUILD_DIR)/preprocessor.o: $(CBM_DIR)/preprocessor.cpp | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS_TEST) -w -I$(CBM_DIR)/vendored -c -o $@ $<

# ── Full test binary ─────────────────────────────────────────────

# mimalloc object files
MIMALLOC_OBJ_TEST = $(BUILD_DIR)/mimalloc.o
MIMALLOC_OBJ_PROD = $(BUILD_DIR)/prod_mimalloc.o

$(BUILD_DIR)/mimalloc.o: $(MIMALLOC_SRC) | $(BUILD_DIR)
	$(CC) $(MIMALLOC_CFLAGS_TEST) -c -o $@ $<

$(BUILD_DIR)/prod_mimalloc.o: $(MIMALLOC_SRC) | $(BUILD_DIR)
	$(CC) $(MIMALLOC_CFLAGS) -c -o $@ $<

# sqlite3 object files (vendored amalgamation)
SQLITE3_OBJ_TEST = $(BUILD_DIR)/sqlite3.o
SQLITE3_OBJ_PROD = $(BUILD_DIR)/prod_sqlite3.o

$(BUILD_DIR)/sqlite3.o: $(SQLITE3_SRC) | $(BUILD_DIR)
	$(CC) $(SQLITE3_CFLAGS_TEST) $(SANITIZE) -c -o $@ $<

$(BUILD_DIR)/prod_sqlite3.o: $(SQLITE3_SRC) | $(BUILD_DIR)
	$(CC) $(SQLITE3_CFLAGS) -c -o $@ $<

# TRE regex (only compiled on Windows — POSIX uses system <regex.h>)
TRE_OBJ_TEST :=
TRE_OBJ_PROD :=
ifeq ($(IS_MINGW),yes)
TRE_OBJ_TEST = $(BUILD_DIR)/tre.o
TRE_OBJ_PROD = $(BUILD_DIR)/prod_tre.o

$(BUILD_DIR)/tre.o: $(TRE_SRC) | $(BUILD_DIR)
	$(CC) $(TRE_CFLAGS) $(SANITIZE) -fno-sanitize=alignment -c -o $@ $<

$(BUILD_DIR)/prod_tre.o: $(TRE_SRC) | $(BUILD_DIR)
	$(CC) $(TRE_CFLAGS) -O2 -c -o $@ $<
endif

# Vendored LZ4 (test build)
LZ4_OBJ_TEST = $(BUILD_DIR)/test_lz4.o $(BUILD_DIR)/test_lz4hc.o
$(BUILD_DIR)/test_lz4.o: $(CBM_DIR)/vendored/lz4/lz4.c | $(BUILD_DIR)
	$(CC) -std=c11 -D_DEFAULT_SOURCE -g -O1 $(SANITIZE) -w -I$(CBM_DIR) -c -o $@ $<
$(BUILD_DIR)/test_lz4hc.o: $(CBM_DIR)/vendored/lz4/lz4hc.c | $(BUILD_DIR)
	$(CC) -std=c11 -D_DEFAULT_SOURCE -g -O1 $(SANITIZE) -w -I$(CBM_DIR)/vendored/lz4 -c -o $@ $<

# Vendored zstd (test build)
ZSTD_OBJ_TEST = $(BUILD_DIR)/test_zstd.o
$(BUILD_DIR)/test_zstd.o: $(CBM_DIR)/vendored/zstd/zstd.c | $(BUILD_DIR)
	$(CC) -std=c11 -D_DEFAULT_SOURCE -g -O1 $(SANITIZE) -w -I$(CBM_DIR)/vendored/zstd -c -o $@ $<

# nomic-embed-code pretrained vector blob
UNIXCODER_OBJ = $(BUILD_DIR)/unixcoder_blob.o
$(UNIXCODER_OBJ): $(UNIXCODER_BLOB_SRC) vendored/nomic/code_vectors.bin | $(BUILD_DIR)
	$(CC) -c -o $@ $<

OBJS_VENDORED_TEST = $(MIMALLOC_OBJ_TEST) $(SQLITE3_OBJ_TEST) $(TRE_OBJ_TEST) $(GRAMMAR_OBJS_TEST) $(TS_RUNTIME_OBJ_TEST) $(LSP_OBJ_TEST) $(PP_OBJ_TEST) $(LZ4_OBJ_TEST) $(ZSTD_OBJ_TEST) $(UNIXCODER_OBJ)

$(BUILD_DIR)/test-runner: $(ALL_TEST_SRCS) $(PROD_SRCS) $(EXTRACTION_SRCS) $(AC_LZ4_SRCS) $(ZSTD_SRCS) $(SQLITE_WRITER_SRC) $(OBJS_VENDORED_TEST) | $(BUILD_DIR)
	$(CC) $(CFLAGS_TEST) -Itests -Itests/repro -o $@ \
		$(ALL_TEST_SRCS) $(PROD_SRCS) \
		$(EXTRACTION_SRCS) $(AC_LZ4_SRCS) $(ZSTD_SRCS) $(SQLITE_WRITER_SRC) \
		$(OBJS_VENDORED_TEST) \
		$(LDFLAGS_TEST)

test: $(BUILD_DIR)/test-runner
	cd $(CURDIR) && $(BUILD_DIR)/test-runner

# ── Cumulative bug-reproduction runner (RED by design, non-gating) ──
# Mirrors test-runner's link line but uses repro_main.c (own main + counters)
# and TEST_REPRO_SRCS instead of ALL_TEST_SRCS. Exits non-zero while any bug is
# still reproduced (the expected state); bug-repro.yml surfaces it as a board.
$(BUILD_DIR)/test-repro-runner: $(TEST_REPRO_SRCS) $(PROD_SRCS) $(EXTRACTION_SRCS) $(AC_LZ4_SRCS) $(ZSTD_SRCS) $(SQLITE_WRITER_SRC) $(OBJS_VENDORED_TEST) | $(BUILD_DIR)
	$(CC) $(CFLAGS_TEST) -Itests -o $@ \
		$(TEST_REPRO_SRCS) $(PROD_SRCS) \
		$(EXTRACTION_SRCS) $(AC_LZ4_SRCS) $(ZSTD_SRCS) $(SQLITE_WRITER_SRC) \
		$(OBJS_VENDORED_TEST) \
		$(LDFLAGS_TEST)

test-repro: $(BUILD_DIR)/test-repro-runner
	cd $(CURDIR) && $(BUILD_DIR)/test-repro-runner

# ── TSan full test ───────────────────────────────────────────────

test-tsan:
	@echo "TSan not yet wired for full extraction tests"

# ── Production binary ────────────────────────────────────────────

# Grammar/TS/LSP objects for production (compiled with relaxed warnings, -O2)
GRAMMAR_OBJS_PROD = $(patsubst $(CBM_DIR)/%.c,$(BUILD_DIR)/prod_%.o,$(GRAMMAR_SRCS))
TS_RUNTIME_OBJ_PROD = $(BUILD_DIR)/prod_ts_runtime.o
LSP_OBJ_PROD = $(BUILD_DIR)/prod_lsp_all.o
PP_OBJ_PROD = $(BUILD_DIR)/prod_preprocessor.o

$(BUILD_DIR)/prod_%.o: $(CBM_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(GRAMMAR_CFLAGS) -c -o $@ $<

$(BUILD_DIR)/prod_ts_runtime.o: $(CBM_DIR)/ts_runtime.c | $(BUILD_DIR)
	$(CC) $(GRAMMAR_CFLAGS) -c -o $@ $<

$(BUILD_DIR)/prod_lsp_all.o: $(LSP_UNITY_DEPS) | $(BUILD_DIR)
	$(CC) $(GRAMMAR_CFLAGS) -c -o $@ $<

$(BUILD_DIR)/prod_preprocessor.o: $(CBM_DIR)/preprocessor.cpp | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS_PROD) -w -I$(CBM_DIR)/vendored -c -o $@ $<

# Vendored LZ4 (compiled separately, not unity-built via lz4_store.c)
LZ4_OBJ_PROD = $(BUILD_DIR)/prod_lz4.o $(BUILD_DIR)/prod_lz4hc.o
$(BUILD_DIR)/prod_lz4.o: $(CBM_DIR)/vendored/lz4/lz4.c | $(BUILD_DIR)
	$(CC) -std=c11 -D_DEFAULT_SOURCE -O2 -w -I$(CBM_DIR) -c -o $@ $<
$(BUILD_DIR)/prod_lz4hc.o: $(CBM_DIR)/vendored/lz4/lz4hc.c | $(BUILD_DIR)
	$(CC) -std=c11 -D_DEFAULT_SOURCE -O2 -w -I$(CBM_DIR)/vendored/lz4 -c -o $@ $<

# Vendored zstd (compiled separately, not unity-built via zstd_store.c)
ZSTD_OBJ_PROD = $(BUILD_DIR)/prod_zstd.o
$(BUILD_DIR)/prod_zstd.o: $(CBM_DIR)/vendored/zstd/zstd.c | $(BUILD_DIR)
	$(CC) -std=c11 -D_DEFAULT_SOURCE -O2 -w -I$(CBM_DIR)/vendored/zstd -c -o $@ $<

OBJS_VENDORED_PROD = $(MIMALLOC_OBJ_PROD) $(SQLITE3_OBJ_PROD) $(TRE_OBJ_PROD) $(GRAMMAR_OBJS_PROD) $(TS_RUNTIME_OBJ_PROD) $(LSP_OBJ_PROD) $(PP_OBJ_PROD) $(LZ4_OBJ_PROD) $(ZSTD_OBJ_PROD) $(UNIXCODER_OBJ)

MAIN_SRC = src/main.c

# #229: PROD_SRCS_UI substitutes the hash-checked -Werror overlays for the three
# vendored sources; the overlays are order-normal prerequisites so make generates
# them before this link.
$(BUILD_DIR)/codebase-memory-mcp: $(MAIN_SRC) $(PROD_SRCS_UI) $(EXTRACTION_SRCS) $(AC_LZ4_SRCS) $(ZSTD_SRCS) $(SQLITE_WRITER_SRC) $(OBJS_VENDORED_PROD) | $(BUILD_DIR)
	$(CC) $(CFLAGS_PROD) -o $@ \
		$(MAIN_SRC) $(PROD_SRCS_UI) \
		$(EXTRACTION_SRCS) $(AC_LZ4_SRCS) $(ZSTD_SRCS) $(SQLITE_WRITER_SRC) \
		$(OBJS_VENDORED_PROD) \
		$(LDFLAGS)

cbm: $(BUILD_DIR)/codebase-memory-mcp
	@echo "Built: $(BUILD_DIR)/codebase-memory-mcp"

# ── Static library for Astrolabe FFI ─────────────────────────────

ASTROLABE_PATCH_DIR := $(patsubst %/,%,$(dir $(lastword $(MAKEFILE_LIST))))
ASTRO_ALLOC_SHIM_SRC = $(ASTROLABE_PATCH_DIR)/astro_alloc_shim.c
ASTRO_ALLOC_SHIM_OBJ = $(LIBCBM_DIR)/astro_alloc_shim.o
ASTRO_LAYOUT_PROBE_SRC = $(ASTROLABE_PATCH_DIR)/astro_layout_probe.c
ASTRO_LAYOUT_PROBE_OBJ = $(LIBCBM_DIR)/astro_layout_probe.o
ASTRO_FFI_INCLUDE_DIR = $(ASTROLABE_PATCH_DIR)/../../crates/cbm-sys/include
ASTRO_FFI_HEADER = $(ASTRO_FFI_INCLUDE_DIR)/astro_ffi.h
ASTRO_MEM_PRESSURE_PATCH = $(ASTROLABE_PATCH_DIR)/apply_mem_pressure_patch.py
ASTRO_MEM_PRESSURE_SRC = src/foundation/mem.c
ASTRO_MEM_PRESSURE_OVERLAY = $(LIBCBM_DIR)/src/foundation/mem.c
ASTRO_MEM_PRESSURE_OBJ = $(LIBCBM_DIR)/src/foundation/mem.o

# ── #240/#241: store-resolution overlay ──────────────────────────
# Astrolabe-owned store configuration (explicit FFI parameter instead of
# env-as-IPC) plus the fail-closed environment fault record, and the hash-checked
# overlay that teaches the pinned CBM resolvers to use them. Nothing under
# vendor/ is written: every patched source is regenerated into $(LIBCBM_DIR) and
# compiled from there, and the explicit object rules below take precedence over
# the generic $(LIBCBM_DIR)/%.o pattern rule.
ASTRO_ENV_STORE_PATCH = $(ASTROLABE_PATCH_DIR)/env_apply_store_patch.py
ASTRO_ENV_STORE_CONFIG_SRC = $(ASTROLABE_PATCH_DIR)/env_store_config.c
ASTRO_ENV_STORE_CONFIG_HDR = $(ASTROLABE_PATCH_DIR)/env_store_config.h
ASTRO_ENV_STORE_CONFIG_OBJ = $(LIBCBM_DIR)/env_store_config.o
ASTRO_ENV_STORE_SRCS = src/foundation/platform.c src/pipeline/pipeline.c src/cli/cli.c \
                       src/mcp/mcp.c src/ui/http_server.c
ASTRO_ENV_STORE_OVERLAYS = $(patsubst %.c,$(LIBCBM_DIR)/%.c,$(ASTRO_ENV_STORE_SRCS))
ASTRO_ENV_STORE_OBJS = $(patsubst %.c,$(LIBCBM_DIR)/%.o,$(ASTRO_ENV_STORE_SRCS))
ASTRO_ENV_STORE_INC = -I$(ASTROLABE_PATCH_DIR)

PYTHON ?= python
LIBCBM_DIR = $(BUILD_DIR)/libcbm
LIBCBM_CONFIG_STAMP ?=
LIBCBM_SRCS = $(PROD_SRCS) $(EXTRACTION_SRCS) $(AC_LZ4_SRCS) $(ZSTD_SRCS) $(SQLITE_WRITER_SRC) \
              $(GRAMMAR_SRCS) $(TS_RUNTIME_SRC) $(CBM_DIR)/lsp_all.c $(PREPROCESSOR_SRC) \
              $(MIMALLOC_SRC) $(SQLITE3_SRC) $(CBM_DIR)/vendored/lz4/lz4.c \
              $(CBM_DIR)/vendored/lz4/lz4hc.c $(CBM_DIR)/vendored/zstd/zstd.c
ifeq ($(IS_MINGW),yes)
LIBCBM_SRCS += $(TRE_SRC)
endif
LIBCBM_C_OBJS = $(patsubst %.c,$(LIBCBM_DIR)/%.o,$(filter %.c,$(LIBCBM_SRCS)))
LIBCBM_CXX_OBJS = $(patsubst %.cpp,$(LIBCBM_DIR)/%.o,$(filter %.cpp,$(LIBCBM_SRCS)))
LIBCBM_ASM_OBJS = $(patsubst %.S,$(LIBCBM_DIR)/%.o,$(UNIXCODER_BLOB_SRC))
LIBCBM_OBJS = $(LIBCBM_C_OBJS) $(LIBCBM_CXX_OBJS) $(LIBCBM_ASM_OBJS) $(ASTRO_ALLOC_SHIM_OBJ) $(ASTRO_LAYOUT_PROBE_OBJ) $(ASTRO_ENV_STORE_CONFIG_OBJ)
# Compiler depfiles cover transitive includes; the config stamp covers command
# inputs that Make cannot infer from source timestamps.
LIBCBM_DEPFILES = $(LIBCBM_OBJS:.o=.d)
LIBCBM_DEPFLAGS = -MMD -MP
LIBCBM_CFLAGS = $(CFLAGS_PROD) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_CXXFLAGS = $(CXXFLAGS_PROD) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_GRAMMAR_CFLAGS = $(GRAMMAR_CFLAGS) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_SQLITE3_CFLAGS = $(SQLITE3_CFLAGS) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_MIMALLOC_CFLAGS = $(MIMALLOC_CFLAGS) -fvisibility=hidden -DCBM_BUILDING_LIB=1
ifeq ($(LIBCBM_ASAN),1)
LIBCBM_CFLAGS = $(CFLAGS_COMMON) -g -O1 $(CFLAGS_EXTRA) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_CXXFLAGS = $(CXXFLAGS_COMMON) -g -O1 $(CXXFLAGS_EXTRA) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_GRAMMAR_CFLAGS = $(GRAMMAR_CFLAGS) -g -O1 $(CFLAGS_EXTRA) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_SQLITE3_CFLAGS = $(SQLITE3_CFLAGS) $(CFLAGS_EXTRA) -fvisibility=hidden -DCBM_BUILDING_LIB=1
LIBCBM_MIMALLOC_CFLAGS = $(MIMALLOC_CFLAGS_TEST) $(CFLAGS_EXTRA) -fvisibility=hidden -DCBM_BUILDING_LIB=1
endif
LIBCBM_CFLAGS += $(LIBCBM_DEPFLAGS)
LIBCBM_CXXFLAGS += $(LIBCBM_DEPFLAGS)
LIBCBM_GRAMMAR_CFLAGS += $(LIBCBM_DEPFLAGS)
LIBCBM_SQLITE3_CFLAGS += $(LIBCBM_DEPFLAGS)
LIBCBM_MIMALLOC_CFLAGS += $(LIBCBM_DEPFLAGS)

# ── BEGIN Astrolabe #227/#228: shell-free git spawn + validator overlays ──────
#
# #227: CBM's git helpers composed a command STRING for cbm_popen, which runs
# `cmd.exe /c <string>` on Windows (the CRT's _popen "executes a spawned copy of
# the command processor") and `/bin/sh -c <string>` on POSIX. cmd.exe performs
# %VAR% substitution and ^ escaping at PARSE time — before quoting applies — so
# no quoting of an interpolated repo path can make the string inert, and every
# new metacharacter class becomes another blocklist entry. These overlays route
# every git shell-out through cbm_spawn_capture (patches/cbm/astro_spawn.c),
# which spawns git with an explicit argv via CreateProcessW / posix_spawnp: no
# shell, therefore nothing to escape.
#
# #228: the C validator cbm_validate_shell_arg gains the Windows % ^ ! rejection
# the Rust bridge validator got in #136 (defence in depth, not the only barrier).
#
# Overlays are hash-checked and build-local: the generators read the pinned
# vendor bytes, verify their sha256, and write into $(LIBCBM_DIR). They never
# write into vendor/codebase-memory-mcp.
ASTRO_SPAWN_SRC = $(ASTROLABE_PATCH_DIR)/astro_spawn.c
ASTRO_SPAWN_HDR = $(ASTROLABE_PATCH_DIR)/astro_spawn.h
ASTRO_SPAWN_OBJ = $(LIBCBM_DIR)/astro_spawn.o
ASTRO_OVERLAY_LIB = $(ASTROLABE_PATCH_DIR)/astro_overlay.py

ASTRO_SPAWN_GIT_CONTEXT_PATCH = $(ASTROLABE_PATCH_DIR)/apply_spawn_git_context_patch.py
ASTRO_SPAWN_GIT_CONTEXT_SRC = src/git/git_context.c
ASTRO_SPAWN_GIT_CONTEXT_OVERLAY = $(LIBCBM_DIR)/src/git/git_context.c
ASTRO_SPAWN_GIT_CONTEXT_OBJ = $(LIBCBM_DIR)/src/git/git_context.o

ASTRO_SPAWN_ARTIFACT_PATCH = $(ASTROLABE_PATCH_DIR)/apply_spawn_artifact_patch.py
ASTRO_SPAWN_ARTIFACT_SRC = src/pipeline/artifact.c
ASTRO_SPAWN_ARTIFACT_OVERLAY = $(LIBCBM_DIR)/src/pipeline/artifact.c
ASTRO_SPAWN_ARTIFACT_OBJ = $(LIBCBM_DIR)/src/pipeline/artifact.o

ASTRO_SPAWN_WATCHER_PATCH = $(ASTROLABE_PATCH_DIR)/apply_spawn_watcher_patch.py
ASTRO_SPAWN_WATCHER_SRC = src/watcher/watcher.c
ASTRO_SPAWN_WATCHER_OVERLAY = $(LIBCBM_DIR)/src/watcher/watcher.c
ASTRO_SPAWN_WATCHER_OBJ = $(LIBCBM_DIR)/src/watcher/watcher.o

ASTRO_SPAWN_GITHISTORY_PATCH = $(ASTROLABE_PATCH_DIR)/apply_spawn_githistory_patch.py
ASTRO_SPAWN_GITHISTORY_SRC = src/pipeline/pass_githistory.c
ASTRO_SPAWN_GITHISTORY_OVERLAY = $(LIBCBM_DIR)/src/pipeline/pass_githistory.c
ASTRO_SPAWN_GITHISTORY_OBJ = $(LIBCBM_DIR)/src/pipeline/pass_githistory.o

ASTRO_SHELLARG_STR_UTIL_PATCH = $(ASTROLABE_PATCH_DIR)/apply_shellarg_str_util_patch.py
ASTRO_SHELLARG_STR_UTIL_SRC = src/foundation/str_util.c
ASTRO_SHELLARG_STR_UTIL_OVERLAY = $(LIBCBM_DIR)/src/foundation/str_util.c
ASTRO_SHELLARG_STR_UTIL_OBJ = $(LIBCBM_DIR)/src/foundation/str_util.o

# The spawn helper compiles as an ordinary libcbm object; it exports the single
# cbm_-prefixed symbol cbm_spawn_capture, so the libcbm export filter keeps it.
LIBCBM_OBJS += $(ASTRO_SPAWN_OBJ)

$(ASTRO_SPAWN_OBJ): $(ASTRO_SPAWN_SRC) $(ASTRO_SPAWN_HDR) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) -I$(ASTROLABE_PATCH_DIR) -c -o $@ $<

$(ASTRO_SPAWN_GIT_CONTEXT_OVERLAY): $(ASTRO_SPAWN_GIT_CONTEXT_SRC) \
                                    $(ASTRO_SPAWN_GIT_CONTEXT_PATCH) $(ASTRO_OVERLAY_LIB)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_SPAWN_GIT_CONTEXT_PATCH) $< $@

$(ASTRO_SPAWN_GIT_CONTEXT_OBJ): $(ASTRO_SPAWN_GIT_CONTEXT_OVERLAY) $(ASTRO_SPAWN_HDR) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) -I$(ASTROLABE_PATCH_DIR) -c -o $@ $<

$(ASTRO_SPAWN_ARTIFACT_OVERLAY): $(ASTRO_SPAWN_ARTIFACT_SRC) \
                                 $(ASTRO_SPAWN_ARTIFACT_PATCH) $(ASTRO_OVERLAY_LIB)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_SPAWN_ARTIFACT_PATCH) $< $@

$(ASTRO_SPAWN_ARTIFACT_OBJ): $(ASTRO_SPAWN_ARTIFACT_OVERLAY) $(ASTRO_SPAWN_HDR) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) -I$(ASTROLABE_PATCH_DIR) -c -o $@ $<

$(ASTRO_SPAWN_WATCHER_OVERLAY): $(ASTRO_SPAWN_WATCHER_SRC) \
                                $(ASTRO_SPAWN_WATCHER_PATCH) $(ASTRO_OVERLAY_LIB)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_SPAWN_WATCHER_PATCH) $< $@

$(ASTRO_SPAWN_WATCHER_OBJ): $(ASTRO_SPAWN_WATCHER_OVERLAY) $(ASTRO_SPAWN_HDR) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) -I$(ASTROLABE_PATCH_DIR) -c -o $@ $<

$(ASTRO_SPAWN_GITHISTORY_OVERLAY): $(ASTRO_SPAWN_GITHISTORY_SRC) \
                                   $(ASTRO_SPAWN_GITHISTORY_PATCH) $(ASTRO_OVERLAY_LIB)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_SPAWN_GITHISTORY_PATCH) $< $@

$(ASTRO_SPAWN_GITHISTORY_OBJ): $(ASTRO_SPAWN_GITHISTORY_OVERLAY) $(ASTRO_SPAWN_HDR) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) -I$(ASTROLABE_PATCH_DIR) -c -o $@ $<

$(ASTRO_SHELLARG_STR_UTIL_OVERLAY): $(ASTRO_SHELLARG_STR_UTIL_SRC) \
                                    $(ASTRO_SHELLARG_STR_UTIL_PATCH) $(ASTRO_OVERLAY_LIB)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_SHELLARG_STR_UTIL_PATCH) $< $@

# str_util.c includes its own header by local name, exactly like the mem.c
# overlay: keep the original local-header search path.
$(ASTRO_SHELLARG_STR_UTIL_OBJ): $(ASTRO_SHELLARG_STR_UTIL_OVERLAY) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) -Isrc/foundation -c -o $@ $<

# The CBM clang-format gate validates the overlay bytes we actually compile,
# never a vendored file. `?=` matches the definition further down; ci-cbm-lint.sh
# overrides it on the command line with a temporary workspace.
ASTRO_FORMAT_OVERLAY_DIR ?= $(BUILD_DIR)/astrolabe-format-overlay
ASTRO_SPAWN_FORMAT_OVERLAYS = \
	$(ASTRO_FORMAT_OVERLAY_DIR)/$(ASTRO_SPAWN_GIT_CONTEXT_SRC) \
	$(ASTRO_FORMAT_OVERLAY_DIR)/$(ASTRO_SPAWN_ARTIFACT_SRC) \
	$(ASTRO_FORMAT_OVERLAY_DIR)/$(ASTRO_SPAWN_WATCHER_SRC) \
	$(ASTRO_FORMAT_OVERLAY_DIR)/$(ASTRO_SPAWN_GITHISTORY_SRC) \
	$(ASTRO_FORMAT_OVERLAY_DIR)/$(ASTRO_SHELLARG_STR_UTIL_SRC)

$(ASTRO_FORMAT_OVERLAY_DIR)/$(ASTRO_SPAWN_GIT_CONTEXT_SRC): $(ASTRO_SPAWN_GIT_CONTEXT_SRC) \
                                                            $(ASTRO_SPAWN_GIT_CONTEXT_PATCH)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_SPAWN_GIT_CONTEXT_PATCH) $< $@

$(ASTRO_FORMAT_OVERLAY_DIR)/$(ASTRO_SPAWN_ARTIFACT_SRC): $(ASTRO_SPAWN_ARTIFACT_SRC) \
                                                         $(ASTRO_SPAWN_ARTIFACT_PATCH)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_SPAWN_ARTIFACT_PATCH) $< $@

$(ASTRO_FORMAT_OVERLAY_DIR)/$(ASTRO_SPAWN_WATCHER_SRC): $(ASTRO_SPAWN_WATCHER_SRC) \
                                                        $(ASTRO_SPAWN_WATCHER_PATCH)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_SPAWN_WATCHER_PATCH) $< $@

$(ASTRO_FORMAT_OVERLAY_DIR)/$(ASTRO_SPAWN_GITHISTORY_SRC): $(ASTRO_SPAWN_GITHISTORY_SRC) \
                                                           $(ASTRO_SPAWN_GITHISTORY_PATCH)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_SPAWN_GITHISTORY_PATCH) $< $@

$(ASTRO_FORMAT_OVERLAY_DIR)/$(ASTRO_SHELLARG_STR_UTIL_SRC): $(ASTRO_SHELLARG_STR_UTIL_SRC) \
                                                            $(ASTRO_SHELLARG_STR_UTIL_PATCH)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_SHELLARG_STR_UTIL_PATCH) $< $@

# Additional prerequisite on the existing gate target (GNU Make merges
# prerequisites; only lint-format-astrolabe carries a recipe). ci-cbm-lint.sh
# therefore format-checks these overlays with no change to the script.
lint-format-astrolabe: astro-lint-format-spawn

astro-lint-format-spawn: $(ASTRO_SPAWN_FORMAT_OVERLAYS)
	@echo "=== clang-format (Astrolabe #227/#228 spawn overlays) ==="
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror \
		--assume-filename=$(ASTRO_SPAWN_GIT_CONTEXT_SRC) \
		< $(ASTRO_FORMAT_OVERLAY_DIR)/$(ASTRO_SPAWN_GIT_CONTEXT_SRC)
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror \
		--assume-filename=$(ASTRO_SPAWN_ARTIFACT_SRC) \
		< $(ASTRO_FORMAT_OVERLAY_DIR)/$(ASTRO_SPAWN_ARTIFACT_SRC)
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror \
		--assume-filename=$(ASTRO_SPAWN_WATCHER_SRC) \
		< $(ASTRO_FORMAT_OVERLAY_DIR)/$(ASTRO_SPAWN_WATCHER_SRC)
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror \
		--assume-filename=$(ASTRO_SPAWN_GITHISTORY_SRC) \
		< $(ASTRO_FORMAT_OVERLAY_DIR)/$(ASTRO_SPAWN_GITHISTORY_SRC)
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror \
		--assume-filename=$(ASTRO_SHELLARG_STR_UTIL_SRC) \
		< $(ASTRO_FORMAT_OVERLAY_DIR)/$(ASTRO_SHELLARG_STR_UTIL_SRC)
	@# The reviewed spawn helper lives outside the vendor tree, so feed it via
	@# stdin with a vendor-relative assume-filename to resolve the CBM .clang-format.
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror \
		--assume-filename=src/foundation/astro_spawn.c < $(ASTRO_SPAWN_SRC)
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror \
		--assume-filename=src/foundation/astro_spawn.h < $(ASTRO_SPAWN_HDR)
# ── END Astrolabe #227/#228 ───────────────────────────────────────────────────

# ── BEGIN Astrolabe #229: production-binary -Werror overlay generation ─────────
# Hash-checked, build-local overlays that clear the native MinGW GCC 14.1 -Werror
# diagnostics blocking `cbm-with-ui` (and fix a genuine unchecked allocation-size
# bug in src/ui/layout3d.c). The generator verifies each vendored source's sha256
# before patching a copy and fails closed on drift; it never writes into vendor/.
# The static pattern rule maps $(ASTRO_UI_WERROR_OVERLAY_DIR)/<rel>.c back to the
# vendored <rel>.c and passes that same relative path as the generator's --file
# selector.
ASTRO_UI_WERROR_PATCH = $(ASTROLABE_PATCH_DIR)/apply_ui_werror_patch.py

$(ASTRO_UI_WERROR_OVERLAYS): $(ASTRO_UI_WERROR_OVERLAY_DIR)/%.c: %.c $(ASTRO_UI_WERROR_PATCH) $(ASTRO_OVERLAY_LIB)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_UI_WERROR_PATCH) --file $< $< $@
# ── END Astrolabe #229 ────────────────────────────────────────────────────────

ifneq ($(strip $(LIBCBM_CONFIG_STAMP)),)
$(LIBCBM_OBJS): $(LIBCBM_CONFIG_STAMP)
endif

-include $(LIBCBM_DEPFILES)

LIBCBM_A = $(BUILD_DIR)/libcbm.a
LIBCBM_RELOC = $(BUILD_DIR)/libcbm.o
LIBCBM_EXPORTS = $(BUILD_DIR)/libcbm.exports
LIBCBM_OBJECTS_RSP = $(BUILD_DIR)/libcbm.objects.rsp

$(LIBCBM_DIR)/$(CBM_DIR)/grammar_%.o: $(CBM_DIR)/grammar_%.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_GRAMMAR_CFLAGS) -c -o $@ $<

$(LIBCBM_DIR)/$(CBM_DIR)/ts_runtime.o: $(CBM_DIR)/ts_runtime.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_GRAMMAR_CFLAGS) -c -o $@ $<

$(LIBCBM_DIR)/$(CBM_DIR)/lsp_all.o: $(LSP_UNITY_DEPS) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_GRAMMAR_CFLAGS) -c -o $@ $<

$(LIBCBM_DIR)/$(CBM_DIR)/preprocessor.o: $(CBM_DIR)/preprocessor.cpp | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CXX) $(LIBCBM_CXXFLAGS) -w -I$(CBM_DIR)/vendored -c -o $@ $<

$(LIBCBM_DIR)/$(MIMALLOC_SRC:.c=.o): $(MIMALLOC_SRC) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_MIMALLOC_CFLAGS) -c -o $@ $<

$(ASTRO_ALLOC_SHIM_OBJ): $(ASTRO_ALLOC_SHIM_SRC) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) -Ivendored/mimalloc/include -Ivendored/mimalloc/src -c -o $@ $<

$(ASTRO_LAYOUT_PROBE_OBJ): $(ASTRO_LAYOUT_PROBE_SRC) $(ASTRO_FFI_HEADER) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) -I$(ASTRO_FFI_INCLUDE_DIR) -c -o $@ $<

$(ASTRO_MEM_PRESSURE_OVERLAY): $(ASTRO_MEM_PRESSURE_SRC) $(ASTRO_MEM_PRESSURE_PATCH) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_MEM_PRESSURE_PATCH) $< $@

$(ASTRO_MEM_PRESSURE_OBJ): $(ASTRO_MEM_PRESSURE_OVERLAY) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) -Isrc/foundation -c -o $@ $<

# ── #240/#241: store-resolution overlay build rules ──────────────
# One generator, one hash-checked overlay per pinned source. The overlay is
# written under $(LIBCBM_DIR); vendor/codebase-memory-mcp is never touched.
$(ASTRO_ENV_STORE_CONFIG_OBJ): $(ASTRO_ENV_STORE_CONFIG_SRC) $(ASTRO_ENV_STORE_CONFIG_HDR) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) $(ASTRO_ENV_STORE_INC) -c -o $@ $<

# src/mcp/mcp.c is excluded from the generic env-store rule: it takes a second
# hash-checked overlay pass (#282 worker-failure diagnostics) chained after the
# env-store transform. See the dedicated rule below.
$(filter-out $(LIBCBM_DIR)/src/mcp/mcp.c,$(ASTRO_ENV_STORE_OVERLAYS)): $(LIBCBM_DIR)/%.c: %.c $(ASTRO_ENV_STORE_PATCH) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_ENV_STORE_PATCH) --file $< $< $@

# ── #282: contained index-worker failures carry their own evidence ────────
# Two overlays: index_supervisor.c slurps the worker's --response-out file on
# every outcome (not only CLEAN); mcp.c threads the last failed worker's exit
# code + bounded response text into build_worker_failure_response. mcp.c chains
# AFTER the env-store overlay (both patch the same pinned source; each pass is
# hash/anchor-checked and fails closed on drift). The overlays reach BOTH
# libcbm.a and the production parity binaries (PROD_SRCS_DIAG): the parity
# gates compare astrolabe against the production binary live, so both sides
# must carry identical behavior on shared failure cases (attempt 11, #282).
ASTRO_WORKER_DIAG_PATCH = $(ASTROLABE_PATCH_DIR)/apply_worker_diag_patch.py
ASTRO_WORKER_DIAG_SUPERVISOR_OVERLAY = $(LIBCBM_DIR)/src/mcp/index_supervisor.c
ASTRO_WORKER_DIAG_SUPERVISOR_OBJ = $(LIBCBM_DIR)/src/mcp/index_supervisor.o

# #282: production-binary overlays (declared next to PROD_SRCS_DIAG above; the
# rule lives here because prerequisite lists expand at read time and need
# ASTROLABE_PATCH_DIR).
$(ASTRO_WORKER_DIAG_PROD_OVERLAYS): $(ASTRO_WORKER_DIAG_PROD_DIR)/%.c: %.c $(ASTRO_WORKER_DIAG_PATCH) $(ASTRO_OVERLAY_LIB) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_WORKER_DIAG_PATCH) --file $< $< $@

# index_supervisor.c quote-includes its own header ("index_supervisor.h"),
# which resolves relative to the includer's directory. The prod binary compiles
# every TU in one command with shared -I flags (no per-TU -Isrc/mcp like the
# libcbm object rule), so the UNMODIFIED vendored header must sit next to the
# generated overlay or the compile fails: index_supervisor.h: No such file
# (aggregate attempt 12, 2026-07-12). mcp.c needs no copy — its includes are
# all -Isrc-relative ("mcp/index_supervisor.h").
ASTRO_WORKER_DIAG_PROD_SUPERVISOR_HDR = $(ASTRO_WORKER_DIAG_PROD_DIR)/src/mcp/index_supervisor.h
$(ASTRO_WORKER_DIAG_PROD_SUPERVISOR_HDR): src/mcp/index_supervisor.h | $(BUILD_DIR)
	mkdir -p $(dir $@)
	cp -f $< $@

$(ASTRO_WORKER_DIAG_PROD_DIR)/src/mcp/index_supervisor.c: $(ASTRO_WORKER_DIAG_PROD_SUPERVISOR_HDR)

$(LIBCBM_DIR)/src/mcp/mcp.c: src/mcp/mcp.c $(ASTRO_ENV_STORE_PATCH) $(ASTRO_WORKER_DIAG_PATCH) $(ASTRO_OVERLAY_LIB) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_ENV_STORE_PATCH) --file src/mcp/mcp.c src/mcp/mcp.c $@.envstore
	$(PYTHON) $(ASTRO_WORKER_DIAG_PATCH) --file src/mcp/mcp.c --chained $@.envstore $@
	rm -f $@.envstore

$(ASTRO_WORKER_DIAG_SUPERVISOR_OVERLAY): src/mcp/index_supervisor.c $(ASTRO_WORKER_DIAG_PATCH) $(ASTRO_OVERLAY_LIB) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_WORKER_DIAG_PATCH) --file src/mcp/index_supervisor.c $< $@

$(ASTRO_WORKER_DIAG_SUPERVISOR_OBJ): $(ASTRO_WORKER_DIAG_SUPERVISOR_OVERLAY) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) -Isrc/mcp -c -o $@ $<

# Each overlay object depends on its generated source plus the Astrolabe header
# the overlay includes. The sub-directory -I mirrors the vendored source's own
# directory so its quote-includes keep resolving from the generated location.
$(LIBCBM_DIR)/src/foundation/platform.o: $(LIBCBM_DIR)/src/foundation/platform.c $(ASTRO_ENV_STORE_CONFIG_HDR) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) $(ASTRO_ENV_STORE_INC) -Isrc/foundation -c -o $@ $<

$(LIBCBM_DIR)/src/pipeline/pipeline.o: $(LIBCBM_DIR)/src/pipeline/pipeline.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) $(ASTRO_ENV_STORE_INC) -Isrc/pipeline -c -o $@ $<

$(LIBCBM_DIR)/src/cli/cli.o: $(LIBCBM_DIR)/src/cli/cli.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) $(ASTRO_ENV_STORE_INC) -Isrc/cli -c -o $@ $<

$(LIBCBM_DIR)/src/mcp/mcp.o: $(LIBCBM_DIR)/src/mcp/mcp.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) $(ASTRO_ENV_STORE_INC) -Isrc/mcp -c -o $@ $<

$(LIBCBM_DIR)/src/ui/http_server.o: $(LIBCBM_DIR)/src/ui/http_server.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) $(ASTRO_ENV_STORE_INC) -Isrc/ui -c -o $@ $<

$(LIBCBM_DIR)/$(SQLITE3_SRC:.c=.o): $(SQLITE3_SRC) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_SQLITE3_CFLAGS) -c -o $@ $<

$(LIBCBM_DIR)/$(TRE_SRC:.c=.o): $(TRE_SRC) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(TRE_CFLAGS) $(LIBCBM_DEPFLAGS) -O2 -fvisibility=hidden -c -o $@ $<

$(LIBCBM_DIR)/$(CBM_DIR)/vendored/lz4/%.o: $(CBM_DIR)/vendored/lz4/%.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_DEPFLAGS) -std=c11 -D_DEFAULT_SOURCE -O2 -fvisibility=hidden -w -I$(CBM_DIR) -I$(CBM_DIR)/vendored/lz4 -c -o $@ $<

$(LIBCBM_DIR)/$(CBM_DIR)/vendored/zstd/zstd.o: $(CBM_DIR)/vendored/zstd/zstd.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_DEPFLAGS) -std=c11 -D_DEFAULT_SOURCE -O2 -fvisibility=hidden -w -I$(CBM_DIR)/vendored/zstd -c -o $@ $<

$(LIBCBM_DIR)/%.o: %.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_CFLAGS) -c -o $@ $<

$(LIBCBM_DIR)/%.o: %.cpp | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CXX) $(LIBCBM_CXXFLAGS) -c -o $@ $<

$(LIBCBM_DIR)/$(UNIXCODER_BLOB_SRC:.S=.o): $(UNIXCODER_BLOB_SRC) vendored/nomic/code_vectors.bin | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_DEPFLAGS) -fvisibility=hidden -c -o $@ $<

$(LIBCBM_DIR)/%.o: %.S | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(LIBCBM_DEPFLAGS) -fvisibility=hidden -c -o $@ $<

$(LIBCBM_RELOC): $(LIBCBM_OBJS)
	$(file >$(LIBCBM_OBJECTS_RSP),$(LIBCBM_OBJS))
	$(LD) -r $(NO_EXECSTACK_LD_FLAG) $(MINGW_RELOC_LD_FLAGS) -o $@ @$(LIBCBM_OBJECTS_RSP)
	$(NM) -g $@ | awk '$$1 != "U" && $$2 != "U" {print $$NF}' | grep -E '^_?cbm_' > $(LIBCBM_EXPORTS)
	if command -v $(OBJCOPY) >/dev/null 2>&1; then \
		if [ "$(IS_MINGW)" = "yes" ]; then $(OBJCOPY) --remove-section=.drectve $@; fi; \
		$(OBJCOPY) --keep-global-symbols=$(LIBCBM_EXPORTS) $@; \
	else \
		echo "WARNING: objcopy not found; libcbm symbol localization skipped"; \
	fi

$(LIBCBM_A): $(LIBCBM_RELOC)
	rm -f $@
	$(AR) rcs $@ $(LIBCBM_RELOC)

libcbm: $(LIBCBM_A)
	@echo "Built static library: $(LIBCBM_A)"

# ── Build with embedded UI (requires Node.js) ───────────────────

# Swap embedded_stub.c for the generated embedded_assets.c
UI_SRCS_WITH_ASSETS = $(subst src/ui/embedded_stub.c,src/ui/embedded_assets.c,$(UI_SRCS))
PROD_SRCS_WITH_ASSETS = $(subst src/ui/embedded_stub.c,src/ui/embedded_assets.c,$(PROD_SRCS))
# #229: same embedded-asset swap, but on top of the -Werror overlay substitution
# (PROD_SRCS_UI). embedded_stub.c is disjoint from the three overlaid sources, so
# the two substitutions compose cleanly.
PROD_SRCS_WITH_ASSETS_UI = $(subst src/ui/embedded_stub.c,src/ui/embedded_assets.c,$(PROD_SRCS_UI))

# Embedded asset object files (generated by embed script)
EMBED_OBJS = $(wildcard $(BUILD_DIR)/embedded/embed_*.o)

frontend:
	cd graph-ui && npm ci && npm run build

embed: frontend
	scripts/embed-frontend.sh graph-ui/dist $(BUILD_DIR)/embedded

# #229: PROD_SRCS_WITH_ASSETS_UI compiles the -Werror overlays; the overlays are
# prerequisites so make generates them before this link.
cbm-with-ui: embed $(OBJS_VENDORED_PROD) $(ASTRO_UI_WERROR_OVERLAYS)
	$(CC) $(CFLAGS_PROD) -o $(BUILD_DIR)/codebase-memory-mcp \
		$(MAIN_SRC) $(PROD_SRCS_WITH_ASSETS_UI) \
		$(EXTRACTION_SRCS) $(AC_LZ4_SRCS) $(ZSTD_SRCS) $(SQLITE_WRITER_SRC) \
		$(OBJS_VENDORED_PROD) \
		$(wildcard $(BUILD_DIR)/embedded/embed_*.o) \
		$(LDFLAGS)
	@echo "Built with UI: $(BUILD_DIR)/codebase-memory-mcp"

clean-c:
	rm -rf $(BUILD_DIR)

# ── Linting ─────────────────────────────────────────────────────

# clang-tidy and clang-format: use Homebrew LLVM on macOS, overridable via make args
# e.g. make lint-format CLANG_FORMAT=clang-format-18
LLVM_BIN := $(shell brew --prefix llvm 2>/dev/null)/bin
CLANG_TIDY ?= $(shell [ -x "$(LLVM_BIN)/clang-tidy" ] && echo "$(LLVM_BIN)/clang-tidy" || echo clang-tidy)
CLANG_FORMAT ?= $(shell [ -x "$(LLVM_BIN)/clang-format" ] && echo "$(LLVM_BIN)/clang-format" || echo clang-format)
CLANG_FORMAT_FOR_SHELL := $(subst \,/,$(CLANG_FORMAT))
CPPCHECK ?= cppcheck

# macOS SDK sysroot (needed for Homebrew LLVM to find system headers)
SYSROOT = $(shell xcrun --show-sdk-path 2>/dev/null)
SYSROOT_FLAG = $(if $(SYSROOT),-isysroot $(SYSROOT),)

# Our source files (excluding vendored, grammars, tree-sitter runtime)
LINT_SRCS = $(FOUNDATION_SRCS) $(STORE_SRCS) $(CYPHER_SRCS) $(MCP_SRCS) \
            $(DISCOVER_SRCS) $(GRAPH_BUFFER_SRCS) $(PIPELINE_SRCS) $(SIMHASH_SRCS) $(SEMANTIC_SRCS) \
            $(TRACES_SRCS) $(WATCHER_SRCS) $(CLI_SRCS) $(EXTRACTION_SRCS) $(AC_LZ4_SRCS) \
            $(ZSTD_SRCS) $(SQLITE_WRITER_SRC) $(MAIN_SRC)
LINT_HDRS = $(wildcard src/**/*.h src/*.h $(CBM_DIR)/*.h)
LINT_TEST_SRCS = $(ALL_TEST_SRCS)
ASTRO_GRAPH_BUFFER_FORMAT_PATCH = $(ASTROLABE_PATCH_DIR)/apply_graph_buffer_format_patch.py
ASTRO_GRAPH_BUFFER_FORMAT_SRC = src/graph_buffer/graph_buffer.c
ASTRO_FORMAT_OVERLAY_DIR ?= $(BUILD_DIR)/astrolabe-format-overlay
ASTRO_GRAPH_BUFFER_FORMAT_OVERLAY = $(ASTRO_FORMAT_OVERLAY_DIR)/src/graph_buffer/graph_buffer.c
ASTRO_LINT_FORMAT_SRCS = $(filter-out $(ASTRO_GRAPH_BUFFER_FORMAT_SRC),$(LINT_SRCS))
# #240/#241: format-check the generated store overlays too. The pinned vendor
# sources stay in ASTRO_LINT_FORMAT_SRCS above (they are format-clean and must
# remain so); these additional copies prove the OVERLAY Astrolabe actually
# compiles into libcbm.a is format-clean as well, so a patched region can never
# become the one unformatted corner of the C tree.
ASTRO_ENV_STORE_FORMAT_OVERLAYS = $(patsubst %.c,$(ASTRO_FORMAT_OVERLAY_DIR)/%.c,$(ASTRO_ENV_STORE_SRCS))
# clang-format resolves its style file by walking up from the assumed filename,
# and this Makefile always runs with the CBM root as the working directory, so an
# in-tree assumed name is what makes ./.clang-format the effective config for the
# Astrolabe-owned sources that live outside the CBM tree.
ASTRO_ENV_STORE_CONFIG_ASSUMED_C = src/foundation/env_store_config.c
ASTRO_ENV_STORE_CONFIG_ASSUMED_H = src/foundation/env_store_config.h

# clang-tidy: deep static analysis (config in .clang-tidy)
lint-tidy:
	@echo "=== clang-tidy ==="
	@$(CLANG_TIDY) --quiet $(LINT_SRCS) -- $(CFLAGS_COMMON) $(SYSROOT_FLAG)

# cppcheck: complementary analysis (config in .cppcheck)
lint-cppcheck:
	@echo "=== cppcheck ==="
	@$(CPPCHECK) --enable=warning,style,performance,portability \
		--std=c11 --language=c \
		--suppressions-list=.cppcheck \
		--error-exitcode=1 \
		--inline-suppr \
		--quiet \
		--suppress=varFuncNullUB \
		--suppress=intToPointerCast \
		--suppress=unusedStructMember \
		--suppress=nullPointerOutOfMemory \
		--suppress=nullPointerArithmeticOutOfMemory \
		--suppress=ctunullpointerOutOfMemory \
		--suppress='nullPointer:internal/cbm/sqlite_writer.c' \
		-Isrc -Ivendored -Ivendored/sqlite3 \
		-I$(CBM_DIR) -I$(TS_INCLUDE) \
		$(LINT_SRCS)

# cppcheck for Astrolabe-owned CBM C (#250): the vendored lint-cppcheck analyzes
# only $(LINT_SRCS) (vendored). The Astrolabe-authored patches/cbm/*.c files are
# the new-code surface most worth static analysis, but previously got clang-format
# only. Same analyzer policy and suppressions as the vendored recipe so findings
# stay directly comparable across the two source sets; varFuncNullUB is suppressed
# here for the same reason it is upstream — cbm_log_error(...) is a sentinel-
# terminated variadic macro (foundation/log.h: cbm_log(..., ##__VA_ARGS__, NULL)),
# so the "NULL after last typed arg" finding is a false positive on every call
# site, vendored or Astrolabe-owned. A real defect (e.g. a memory leak) is still
# caught — see the control proof in #250.
ASTRO_CPPCHECK_SRCS = $(ASTRO_ALLOC_SHIM_SRC) $(ASTRO_LAYOUT_PROBE_SRC) \
                      $(ASTRO_SPAWN_SRC) $(ASTRO_ENV_STORE_CONFIG_SRC)

lint-cppcheck-astrolabe:
	@echo "=== cppcheck (Astrolabe-owned CBM C #250) ==="
	@$(CPPCHECK) --enable=warning,style,performance,portability \
		--std=c11 --language=c \
		--suppressions-list=.cppcheck \
		--error-exitcode=1 \
		--inline-suppr \
		--quiet \
		--suppress=varFuncNullUB \
		--suppress=intToPointerCast \
		--suppress=unusedStructMember \
		--suppress=nullPointerOutOfMemory \
		--suppress=nullPointerArithmeticOutOfMemory \
		--suppress=ctunullpointerOutOfMemory \
		-Isrc -Ivendored -Ivendored/sqlite3 \
		-I$(CBM_DIR) -I$(TS_INCLUDE) \
		-I$(ASTROLABE_PATCH_DIR) -I$(ASTRO_FFI_INCLUDE_DIR) \
		$(ASTRO_CPPCHECK_SRCS)

# clang-format: formatting check (config in .clang-format, dry-run = no changes)
lint-format:
	@echo "=== clang-format ==="
	@$(CLANG_FORMAT) --dry-run --Werror $(LINT_SRCS) $(LINT_HDRS)

# Astrolabe keeps the imported tree pristine. This target validates the exact
# reviewed format-only overlay alongside every remaining upstream lint source.
$(ASTRO_GRAPH_BUFFER_FORMAT_OVERLAY): $(ASTRO_GRAPH_BUFFER_FORMAT_SRC) $(ASTRO_GRAPH_BUFFER_FORMAT_PATCH)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_GRAPH_BUFFER_FORMAT_PATCH) $< $@

$(ASTRO_ENV_STORE_FORMAT_OVERLAYS): $(ASTRO_FORMAT_OVERLAY_DIR)/%.c: %.c $(ASTRO_ENV_STORE_PATCH)
	mkdir -p $(dir $@)
	$(PYTHON) $(ASTRO_ENV_STORE_PATCH) --file $< $< $@

lint-format-astrolabe: $(ASTRO_GRAPH_BUFFER_FORMAT_OVERLAY) $(ASTRO_ENV_STORE_FORMAT_OVERLAYS)
	@echo "=== clang-format (Astrolabe overlay) ==="
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror $(ASTRO_LINT_FORMAT_SRCS) $(LINT_HDRS)
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror --assume-filename=$(ASTRO_GRAPH_BUFFER_FORMAT_SRC) < $(ASTRO_GRAPH_BUFFER_FORMAT_OVERLAY)
	@echo "=== clang-format (Astrolabe store overlay #240/#241) ==="
	@for src in $(ASTRO_ENV_STORE_SRCS); do \
		$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror --assume-filename=$$src \
			< $(ASTRO_FORMAT_OVERLAY_DIR)/$$src || exit 1; \
	done
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror --assume-filename=$(ASTRO_ENV_STORE_CONFIG_ASSUMED_C) < $(ASTRO_ENV_STORE_CONFIG_SRC)
	@$(CLANG_FORMAT_FOR_SHELL) --dry-run --Werror --assume-filename=$(ASTRO_ENV_STORE_CONFIG_ASSUMED_H) < $(ASTRO_ENV_STORE_CONFIG_HDR)

# Ban ALL NOLINT variants EXCEPT whitelisted NOLINT(misc-no-recursion).
# The whitelist is in src/foundation/recursion_whitelist.h with documented reasoning.
# Rule: NOLINT(misc-no-recursion) is allowed ONLY on function definitions that are
# listed in recursion_whitelist.h. All other NOLINT forms are banned.
lint-no-suppress:
	@echo "=== NOLINT check ==="
	@if grep -rn 'NOLINT' src/ internal/cbm/*.c internal/cbm/*.h 2>/dev/null \
		| grep -v vendored \
		| grep -v 'NOLINT(misc-no-recursion)' \
		| grep -v 'recursion_whitelist.h'; then \
		echo "ERROR: Banned NOLINT comment found in source code."; \
		echo "Only NOLINT(misc-no-recursion) is allowed, and only for whitelisted functions."; \
		echo "See src/foundation/recursion_whitelist.h for the whitelist."; \
		exit 1; \
	fi
	@echo "  Checking NOLINT(misc-no-recursion) against whitelist..."
	@scripts/check-nolint-whitelist.sh

# All linters (run with make -j3 lint for parallel execution)
lint: lint-tidy lint-cppcheck lint-format lint-no-suppress
	@echo "=== All linters passed ==="

# CI linters (no clang-tidy — platform-dependent, enforced locally via pre-commit)
lint-ci: lint-cppcheck lint-format lint-no-suppress
	@echo "=== CI linters passed ==="

# ── Security audit (6 layers) ────────────────────────────────────

# Run all security checks: static audit, binary strings, UI, install, network
# Requires: production binary already built (make cbm)
security: cbm
	@echo "=== Running security audit suite ==="
	scripts/security-audit.sh
	scripts/security-strings.sh $(BUILD_DIR)/codebase-memory-mcp
	scripts/security-ui.sh
	scripts/security-install.sh $(BUILD_DIR)/codebase-memory-mcp
	scripts/security-network.sh $(BUILD_DIR)/codebase-memory-mcp
	scripts/security-fuzz.sh $(BUILD_DIR)/codebase-memory-mcp
	scripts/security-vendored.sh
	@echo "=== All security checks passed ==="
