#!/bin/sh
# #519/#424: authoritative ref-only backstop. Git 2.54 exposes `preparing` before
# it acquires ref locks, while `prepared` remains the last-chance state on older/current
# implementations. Refuse in either pre-commit phase. Scope is HEAD and local branches;
# remote-tracking updates do not mutate the evidence tree and remain allowed.

state="$1"
updates=$(cat)
case "$state" in
    preparing|prepared)
        ;;
    *)
        exit 0
        ;;
esac

mutating=0
while IFS=' ' read -r old_value new_value refname; do
    [ -n "$refname" ] || continue
    case "$refname" in
        HEAD|refs/heads/*)
            mutating=1
            break
            ;;
    esac
done <<EOF
$updates
EOF

[ $mutating -eq 1 ] || exit 0
. "$(dirname "$0")/astro-freeze-guard.sh"
astro_freeze_guard "reference-transaction($state)" || exit 1
exit 0
