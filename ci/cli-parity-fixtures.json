{
  "schema": "astrolabe.cli_parity_fixtures.v2",
  "setup": [
    {
      "tool": "index_repository",
      "args": {
        "repo_path": "$ASTROLABE_CLI_PARITY_REPO",
        "mode": "full",
        "name": "cli_parity",
        "calyx": "shadow"
      }
    },
    {
      "tool": "index_repository",
      "args": {
        "repo_path": "$ASTROLABE_CLI_PARITY_REPO",
        "mode": "full",
        "name": "cli_parity_delete",
        "calyx": "shadow"
      }
    }
  ],
  "tools": {
    "index_repository": {
      "args": {
        "repo_path": "$ASTROLABE_CLI_PARITY_REINDEX_REPO",
        "mode": "full",
        "name": "cli_parity_reindex",
        "calyx": "shadow"
      }
    },
    "list_projects": {
      "args": {},
      "allow_empty_args": true
    },
    "delete_project": {
      "args": {
        "project": "cli_parity_delete"
      }
    },
    "index_status": {
      "args": {
        "project": "cli_parity"
      }
    },
    "anchor_outcome": {
      "_comment": "#233: exercises the REAL anchor_outcome path end-to-end on the shadow-indexed fixture project (dial check, vault open, node-map resolution, ingest, Grounding ledger append). The 2-line fixture repo maps no test subjects, so the deterministic result is status=noop with the subject counted in unmapped_subjects - an honest counted skip, never a fake anchor.",
      "args": {
        "project": "cli_parity",
        "kind": "test_run",
        "source": "local:cli-parity-fixture",
        "format": "cargo_test_json",
        "report": "{ \"type\": \"suite\", \"event\": \"started\", \"test_count\": 1 }\n{ \"type\": \"test\", \"event\": \"started\", \"name\": \"cli_parity::fixture_probe\" }\n{ \"type\": \"test\", \"name\": \"cli_parity::fixture_probe\", \"event\": \"ok\" }\n{ \"type\": \"suite\", \"event\": \"ok\", \"passed\": 1, \"failed\": 0, \"ignored\": 0, \"measured\": 0, \"filtered_out\": 0, \"exec_time\": 0.01 }",
        "observed_at": 1767225600
      }
    },
    "search_graph": {
      "args": {
        "project": "cli_parity",
        "query": "main",
        "limit": 5
      }
    },
    "trace_path": {
      "args": {
        "project": "cli_parity",
        "function_name": "main",
        "direction": "both",
        "depth": 2
      }
    },
    "detect_changes": {
      "args": {
        "project": "cli_parity",
        "scope": "all",
        "depth": 1
      }
    },
    "query_graph": {
      "args": {
        "project": "cli_parity",
        "query": "MATCH (n) RETURN n LIMIT 1",
        "max_rows": 1
      }
    },
    "get_graph_schema": {
      "args": {
        "project": "cli_parity"
      }
    },
    "get_code_snippet": {
      "args": {
        "project": "cli_parity",
        "qualified_name": "main"
      }
    },
    "get_architecture": {
      "args": {
        "project": "cli_parity",
        "aspects": [
          "overview"
        ]
      }
    },
    "search_code": {
      "args": {
        "project": "cli_parity",
        "pattern": "helper",
        "mode": "compact",
        "limit": 3
      }
    },
    "manage_adr": {
      "args": {
        "project": "cli_parity",
        "mode": "sections",
        "sections": [
          "Context"
        ]
      }
    },
    "ingest_traces": {
      "args": {
        "project": "cli_parity",
        "traces": [
          {
            "caller": "main",
            "callee": "helper",
            "count": 1
          }
        ]
      }
    },
    "detect_anomalies": {
      "args": {
        "project": "cli_parity"
      }
    },
    "get_provenance": {
      "args": {
        "project": "cli_parity",
        "mode": "verify_chain"
      },
      "expect_error": {
        "_comment": "#243: the 2-line fixture repo carries no provenance blocks, so the REAL shadow-import surface persisted at astrolabe.calyx.cli_parity.provenance_json is status:unavailable and get_provenance fails closed. handle_get_provenance calls provenance_store_for_project before any mode logic (dispatch.rs), so every mode hits this refusal. Substrings pinned from provenance.rs:56 (reason) and :580 (remediation). A provenance regression (a #221-class clobber changing the reason, or a fabricated success) makes a substring absent / isError=false and this gate fails RED.",
        "message_contains": [
          "provenance metadata missing; row-sink nodes must declare provenance_lineage",
          "remediation: rerun index_repository with explicit provenance metadata"
        ]
      }
    },
    "optimizer_status": {
      "args": {
        "project": "cli_parity",
        "mode": "status"
      }
    },
    "get_readiness": {
      "args": {
        "project": "cli_parity",
        "scope": "cli_parity"
      }
    },
    "impute_fields": {
      "args": {
        "project": "cli_parity",
        "target": "symbol:cli_parity:main",
        "field": "doc"
      }
    },
    "team_artifact": {
      "args": {
        "mode": "export",
        "project": "cli_parity",
        "artifact_dir": "$ASTROLABE_CLI_PARITY_ARTIFACT_DIR"
      }
    }
  }
}
