{
  "server_requests": [
    {
      "name": "initialize",
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "protocolVersion": "2024-11-05",
          "capabilities": {},
          "clientInfo": {
            "name": "astrolabe-parity",
            "version": "1.0"
          }
        }
      }
    },
    {
      "name": "ping",
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "ping",
        "params": {}
      }
    },
    {
      "name": "tools-list",
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "tools/list",
        "params": {}
      }
    },
    {
      "name": "unknown-method",
      "request": {
        "jsonrpc": "2.0",
        "id": "missing-method",
        "method": "no/such/method",
        "params": {}
      }
    }
  ],
  "tool_cases": [
    {
      "tool": "index_repository",
      "cases": [
        { "name": "empty", "args": {} },
        { "name": "missing-path", "args": { "repo_path": "__astrolabe_no_such_repo__", "mode": "fast" } }
      ]
    },
    {
      "tool": "list_projects",
      "cases": [
        { "name": "empty", "args": {} },
        { "name": "ignored-extra", "args": { "unused": true } }
      ]
    },
    {
      "tool": "delete_project",
      "cases": [
        { "name": "empty", "args": {} },
        { "name": "missing-project", "args": { "project": "__astrolabe_no_such_project__" } }
      ]
    },
    {
      "tool": "index_status",
      "cases": [
        { "name": "empty", "args": {} },
        { "name": "missing-project", "args": { "project": "__astrolabe_no_such_project__" } }
      ]
    },
    {
      "tool": "search_graph",
      "cases": [
        { "name": "empty", "args": {} },
        { "name": "missing-project", "args": { "project": "__astrolabe_no_such_project__", "name_pattern": "main", "limit": 5 } }
      ]
    },
    {
      "tool": "trace_path",
      "cases": [
        { "name": "empty", "args": {} },
        { "name": "missing-project", "args": { "project": "__astrolabe_no_such_project__", "function_name": "main", "direction": "both", "depth": 2 } }
      ]
    },
    {
      "tool": "trace_call_path",
      "cases": [
        { "name": "empty", "args": {} },
        { "name": "alias-missing-project", "args": { "project": "__astrolabe_no_such_project__", "function_name": "main", "direction": "outbound" } }
      ]
    },
    {
      "tool": "detect_changes",
      "cases": [
        { "name": "empty", "args": {} },
        { "name": "missing-project", "args": { "project": "__astrolabe_no_such_project__", "scope": "all", "depth": 1 } }
      ]
    },
    {
      "tool": "query_graph",
      "cases": [
        { "name": "empty", "args": {} },
        { "name": "missing-project", "args": { "project": "__astrolabe_no_such_project__", "query": "MATCH (n) RETURN n LIMIT 1", "max_rows": 1 } }
      ]
    },
    {
      "tool": "get_graph_schema",
      "cases": [
        { "name": "empty", "args": {} },
        { "name": "missing-project", "args": { "project": "__astrolabe_no_such_project__" } }
      ]
    },
    {
      "tool": "get_code_snippet",
      "cases": [
        { "name": "empty", "args": {} },
        { "name": "missing-project", "args": { "project": "__astrolabe_no_such_project__", "qualified_name": "main" } }
      ]
    },
    {
      "tool": "get_architecture",
      "cases": [
        { "name": "empty", "args": {} },
        { "name": "missing-project", "args": { "project": "__astrolabe_no_such_project__", "aspects": ["overview"] } }
      ]
    },
    {
      "tool": "search_code",
      "cases": [
        { "name": "empty", "args": {} },
        { "name": "missing-project", "args": { "project": "__astrolabe_no_such_project__", "pattern": "main", "mode": "compact", "limit": 3 } }
      ]
    },
    {
      "tool": "manage_adr",
      "cases": [
        { "name": "empty", "args": {} },
        { "name": "missing-project", "args": { "project": "__astrolabe_no_such_project__", "mode": "sections", "sections": ["Context"] } }
      ]
    },
    {
      "tool": "ingest_traces",
      "cases": [
        { "name": "empty", "args": {} },
        { "name": "missing-project", "args": { "project": "__astrolabe_no_such_project__", "traces": [] } }
      ]
    }
  ]
}
